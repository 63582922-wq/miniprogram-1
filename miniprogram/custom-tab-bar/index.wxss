@import "../styles/precision-a.wxss";

.custom-tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  box-sizing: border-box;
  padding: 0 var(--a-space-4) env(safe-area-inset-bottom);

  background: var(--a-paper);
  font-family: var(--a-font-body);
}

.custom-tab-bar .custom-tab-bar__item {
  position: relative;
  display: flex;
  width: 0;
  min-height: var(--a-hit-tab);
  box-sizing: border-box;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(var(--a-space-1) / 2);
  margin: 0 !important;
  padding: calc(var(--a-space-1) / 2) 0 !important;
  border: 0;
  background: transparent;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.2;
  transition: color var(--a-motion), transform var(--a-motion);
}

.custom-tab-bar .custom-tab-bar__item::after {
  border: 0;
}

.custom-tab-bar__icon {
  width: 38rpx;
  height: 38rpx;
  transition: transform var(--a-motion);
}

.custom-tab-bar__label {
  color: var(--a-muted);
  font-weight:var(--a-weight-regular);
}

.custom-tab-bar__icon,
.custom-tab-bar__label {
  transform: translateY(calc(var(--a-space-1) / 2));
}

.custom-tab-bar__item.is-selected {
  color: var(--a-ink);
}

.custom-tab-bar__item.is-selected .custom-tab-bar__label {
  color: var(--a-accent-text);
  font-weight:var(--a-weight-emphasis);
}

.custom-tab-bar .custom-tab-bar__item.is-pressed {
  transform: scale(.96);
}
