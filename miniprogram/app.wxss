page {
  background: #FAF9F7;
  color: #1A1814;
  font-size: 26rpx;
  font-family: "Georgia", "Noto Serif SC", "Songti SC", serif;
  min-height: 100%;
}

view,
scroll-view,
swiper,
swiper-item,
button,
input,
textarea,
text,
image {
  box-sizing: border-box;
}

button {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  line-height: 1;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 24rpx 40rpx;
}

.card {
  background: #F2EDE4;
  border-radius: 4rpx;
  padding: 24rpx;
  border: none;
  box-shadow: none;
}

.section-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #1A1814;
  letter-spacing: 0.04em;
}

.section-subtitle {
  font-size: 22rpx;
  color: #6B6355;
  font-weight: 400;
  line-height: 1.55;
}

.primary-button {
  width: 100%;
  height: 88rpx;
  border-radius: 0;
  background: #1A1814;
  color: #D4C5A0;
  font-size: 26rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  letter-spacing: 0.2em;
}

.secondary-button {
  width: 100%;
  height: 88rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 26rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #B8A882;
  letter-spacing: 0.1em;
}

.danger-button {
  width: 100%;
  height: 88rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 26rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #B8A882;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-label {
  font-size: 20rpx;
  color: #6B6355;
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid #E8E2D8;
  border-radius: 0;
  color: #1A1814;
  font-size: 26rpx;
}

.field-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 0;
  color: #1A1814;
}

.field-textarea {
  min-height: 220rpx;
  line-height: 1.6;
  padding: 24rpx 0;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 10rpx 16rpx;
  border-radius: 0;
  font-size: 20rpx;
  line-height: 1;
  background: transparent;
  color: #6B6355;
  border: 0.5px solid #B8A882;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.footer-actions {
  position: sticky;
  bottom: 0;
  padding: 16rpx 0 24rpx;
  background: #FAF9F7;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.footer-actions--fixed {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 30;
  padding: 0;
  border-radius: 0;
  background: transparent;
  backdrop-filter: none;
  box-shadow: none;
}
