@import "./styles/precision-a.wxss";
view,scroll-view,swiper,swiper-item,button,input,textarea,text,image{box-sizing:border-box}
button,input,textarea{font-family:var(--a-font-body)}
button{padding:0;border:0;background:transparent;border-radius:var(--a-radius-control);line-height:1.4}button:after{border:0}button[disabled]{opacity:.42}
.page{min-height:100vh;padding:16rpx var(--a-page-inset) 32rpx;background:var(--a-paper);color:var(--a-ink)}
/* A section is a reading rhythm, not a floating card. Pages use a single
   continuous paper surface and hairline rules only where the subject changes. */
.card{background:transparent;padding:24rpx 0;border:0;border-bottom:1px solid var(--a-line);border-radius:0;box-shadow:none}
.section-title{font-family:var(--a-font-body);font-size:34rpx;font-weight:600;color:var(--a-ink);line-height:1.35}
.section-subtitle{font-size:var(--a-type-meta);color:var(--a-muted);line-height:1.55}
.primary-button,.secondary-button,.danger-button{width:100%;min-height:var(--a-hit);padding:20rpx;display:flex;align-items:center;justify-content:center;font-size:var(--a-type-action);font-weight:600;border-radius:var(--a-radius-control);letter-spacing:0}
.primary-button{min-height:52px;background:var(--a-accent);color:var(--a-accent-ink)}
.secondary-button{background:transparent;color:var(--a-ink);border:1px solid var(--a-line)}
.danger-button{color:var(--a-danger);border:1px solid var(--a-line)}
/* style:v2 gives non-mini buttons a native fixed width. Explicitly override
   that selector so primary actions do not shrink to a narrow centered block. */
.page button.primary-button,.page button.secondary-button,.page button.danger-button{width:100%;margin-left:0;margin-right:0}
.field{display:flex;flex-direction:column;gap:10rpx;margin-bottom:28rpx}.field-label{font-size:var(--a-type-meta);color:var(--a-muted)}
.field-input,.field-textarea{width:100%;background:var(--a-field);border:1px solid var(--a-line);border-radius:var(--a-radius-control);color:var(--a-ink);font-size:var(--a-type-body);padding:20rpx}
.field-input{min-height:48px;line-height:1.5}.field-textarea{min-height:180rpx;line-height:1.7}
.field-label-row,.toolbar{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.tag{padding:6rpx 12rpx;background:var(--a-surface);color:var(--a-muted);font-size:var(--a-type-caption)}
.list{display:flex;flex-direction:column;gap:0}
.footer-actions{position:sticky;bottom:0;background:var(--a-paper);display:flex;flex-direction:column;gap:12rpx;padding:16rpx 0 calc(16rpx + env(safe-area-inset-bottom));border-top:1px solid var(--a-line)}
.footer-actions--fixed{position:fixed;left:0;right:0;bottom:0;z-index:30;padding:12rpx 40rpx calc(12rpx + env(safe-area-inset-bottom));background:var(--a-paper)}
.page-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:24rpx;padding:30rpx 0 22rpx}.page-heading__title{font-family:var(--a-font-body);font-size:var(--a-type-title);font-weight:600;line-height:1.14;letter-spacing:-.6rpx}.page-heading .section-subtitle{margin-top:8rpx;font-size:var(--a-type-caption)}.root-section-heading{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:26rpx 0 12rpx}.root-section-heading__title{font-family:var(--a-font-body);font-size:32rpx;font-weight:600;line-height:1.35;letter-spacing:0}.root-section-label{padding:26rpx 0 10rpx;color:var(--a-muted);font-family:var(--a-font-body);font-size:26rpx;font-weight:400;letter-spacing:.08em}.compact-action{min-height:var(--a-hit);padding:10rpx 0 8rpx 18rpx!important;font-size:var(--a-type-meta)!important;font-weight:600!important;flex-shrink:0;display:flex;align-items:center;background:transparent;color:var(--a-active);margin:0!important;border-radius:0}.is-pressed{opacity:.58;transform:scale(.985)}button,.primary-button,.secondary-button{transition:opacity var(--a-motion),background-color var(--a-motion),transform var(--a-motion)}.primary-button,.secondary-button,.field-input,.field-textarea{border-radius:var(--a-radius-control)}
.page button.compact-action{width:auto}.page-heading>view{min-width:0}.profile-settings-intro{margin:28rpx 0}
