@import "./styles/precision-a.wxss";
view,scroll-view,swiper,swiper-item,button,input,textarea,text,image{box-sizing:border-box}
button,input,textarea{font-family:var(--a-font-body);font-weight:var(--a-weight-regular)}
/* Native mini-program buttons otherwise give inherited card copy an overly
   heavy default weight. Emphasis is opt-in through semantic component roles. */
.ui-button-reset{font-weight:var(--a-weight-regular)}
.ui-button-reset{padding:0;border:0;background:transparent;border-radius:var(--a-radius-pill);line-height:1.4}.ui-button-reset::after{border:0}
/* Defeat style:v2's fixed native width before semantic roles set their size. */
.ui-button-reset{min-width:var(--a-hit);min-height:var(--a-hit);letter-spacing:0;font-family:var(--a-font-body)}
.page .primary-button,.page .secondary-button,.page .danger-button{width:100%;display:flex;align-items:center;justify-content:center;text-align:center}
.page .inspection-row,.page .share-panel__choice{width:100%;margin-left:0;margin-right:0;text-align:left}
.page .request-submit{width:100%;margin-left:0;margin-right:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:var(--a-type-action);line-height:1.35}
.page{min-height:100vh;padding:var(--a-space-2) var(--a-page-inset) calc(var(--a-space-4) + env(safe-area-inset-bottom));background:var(--a-paper);color:var(--a-ink)}
/* A section is a reading rhythm, not a floating card. Pages use a single
   continuous paper surface and hairline rules only where the subject changes. */
.card{background:transparent;padding:var(--a-space-3) 0;border:0;border-radius:0;box-shadow:none}
.section-title{font-family:var(--a-font-body);font-size:var(--a-type-section);font-weight:var(--a-weight-emphasis);color:var(--a-ink);line-height:1.35}
.section-subtitle{font-size:var(--a-type-meta);color:var(--a-muted);line-height:1.55}
.primary-button,.secondary-button,.danger-button{width:100%;min-height:var(--a-hit);padding:var(--a-space-2) var(--a-space-3);display:flex;align-items:center;justify-content:center;gap:var(--a-space-2);font-size:var(--a-type-action);font-weight:var(--a-weight-medium);border-radius:var(--a-radius-pill);letter-spacing:0;line-height:1.35}
.primary-button{min-height:var(--a-hit-primary);background:var(--a-accent);color:var(--a-accent-ink)}
.secondary-button{background:transparent;color:var(--a-ink);border:1px solid var(--a-line)}
.danger-button{color:var(--a-danger);border:1px solid var(--a-line)}
/* style:v2 gives non-mini buttons a native fixed width. Explicitly override
   that selector so primary actions do not shrink to a narrow centered block. */
.page .primary-button,.page .secondary-button,.page .danger-button{width:100%;margin-left:0;margin-right:0}
.field{display:flex;flex-direction:column;gap:var(--a-space-1);margin-bottom:var(--a-space-4)}.field-label{font-size:var(--a-type-caption);color:var(--a-muted);line-height:1.4}
.field-input,.field-textarea{width:100%;background:var(--a-field);border:1px solid var(--a-line);border-radius:var(--a-radius-pill);color:var(--a-ink);font-size:var(--a-type-body);padding:var(--a-space-2) var(--a-space-2)}
.field-input{min-height:var(--a-hit-compact);line-height:1.5}.field-textarea{min-height:180rpx;line-height:1.7}
.field-label-row,.toolbar{display:flex;align-items:center;justify-content:space-between;gap:var(--a-space-2)}
.tag{padding:var(--a-space-1) var(--a-space-2);background:var(--a-surface);color:var(--a-muted);font-size:var(--a-type-caption)}
.list{display:flex;flex-direction:column;gap:0}
.footer-actions{position:sticky;bottom:0;background:var(--a-paper);display:flex;flex-direction:column;gap:var(--a-space-2);padding:var(--a-space-2) 0 calc(var(--a-space-2) + env(safe-area-inset-bottom));}
.footer-actions--fixed{position:fixed;left:0;right:0;bottom:0;z-index:30;padding:var(--a-space-2) var(--a-page-inset) calc(var(--a-space-2) + env(safe-area-inset-bottom));background:var(--a-paper)}
.page-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:var(--a-space-3);padding:var(--a-space-4) 0 var(--a-space-3)}.page-heading__title{font-family:var(--a-font-body);font-size:var(--a-type-title);font-weight:var(--a-weight-emphasis);line-height:1.14;letter-spacing:-.6rpx}.root-section-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--a-space-3);padding:var(--a-space-3) 0 var(--a-space-2)}.root-section-heading__title{font-family:var(--a-font-body);font-size:var(--a-type-body);font-weight:var(--a-weight-emphasis);line-height:1.35;letter-spacing:0}.root-section-label{padding:var(--a-space-3) 0 var(--a-space-1);color:var(--a-muted);font-family:var(--a-font-body);font-size:var(--a-type-caption);font-weight:var(--a-weight-regular);letter-spacing:.08em}.compact-action{min-height:var(--a-hit);padding:var(--a-space-1) 0 var(--a-space-1) var(--a-space-2)!important;font-size:var(--a-type-meta)!important;font-weight:var(--a-weight-emphasis)!important;flex-shrink:0;display:flex;align-items:center;background:transparent;color:var(--a-active);margin:0!important;border-radius:0}.is-pressed{opacity:var(--a-state-pressed);transform:scale(.985)}.is-pressed,.primary-button,.secondary-button{transition:opacity var(--a-motion),background-color var(--a-motion),transform var(--a-motion)}.primary-button,.secondary-button{border-radius:var(--a-radius-pill)}.field-input{border-radius:var(--a-radius-pill)}.field-textarea{border-radius:var(--a-radius-bar)}
.ui-disabled{opacity:var(--a-state-disabled)}
.ui-loading{opacity:var(--a-state-loading)}
.ui-icon{width:var(--a-icon);height:var(--a-icon);flex:none;display:block}
.ui-icon--small{width:var(--a-icon-sm);height:var(--a-icon-sm)}
.ui-icon--large{width:var(--a-icon-lg);height:var(--a-icon-lg)}
.ui-inline-action{min-height:var(--a-hit);padding:0 var(--a-space-1);display:inline-flex;align-items:center;gap:var(--a-space-1);color:var(--a-accent-text);font-size:var(--a-type-caption);font-weight:var(--a-weight-medium)}
.ui-status{display:inline-flex;align-items:center;gap:var(--a-space-1);color:var(--a-muted);font-size:var(--a-type-caption);line-height:1.4}
.ui-status__dot{width:12rpx;height:12rpx;flex:none;border-radius:50%;background:var(--a-bronze)}
.ui-status--active .ui-status__dot{background:var(--a-accent-text)}
.ui-status--error{color:var(--a-danger)}
.page .compact-action{width:auto}.page-heading__title{min-width:0}.profile-settings-intro{margin:var(--a-space-4) 0}
.list-create-action{width:auto!important;min-height:var(--a-hit);margin:0!important;padding:0 var(--a-space-2)!important;display:inline-flex;align-items:center;justify-content:center;gap:var(--a-space-1);background:var(--a-accent);color:var(--a-accent-ink);border-radius:var(--a-radius-pill);font-size:var(--a-type-body);font-weight:var(--a-weight-medium);line-height:1.35;white-space:nowrap;flex:none}.list-create-action::after{border:0}.list-create-action__icon{width:var(--a-icon-sm);height:var(--a-icon-sm);flex:none}
.page .ui-section-row{display:flex;align-items:center;justify-content:space-between;gap:var(--a-space-3);min-height:var(--a-hit)}
.page .ui-section-row__label,.page .ui-section-row__action{display:flex;align-items:center;min-height:var(--a-hit);font-family:var(--a-font-body);font-size:var(--a-type-body);font-weight:var(--a-weight-medium);line-height:1.35;letter-spacing:0}
.page .ui-section-row__label{color:var(--a-ink);min-width:0}
.page .ui-section-row__action{width:auto;margin:0!important;padding:0!important;justify-content:center;background:transparent;border:0;color:var(--a-accent-text);flex:none}
.page .ui-sheet-title{font-family:var(--a-font-body);font-size:var(--a-type-body);font-weight:var(--a-weight-medium);line-height:1.35;text-align:center}
.object-list-title{font-family:var(--a-font-body);font-size:var(--a-type-object);font-weight:var(--a-weight-emphasis);line-height:1.34;letter-spacing:0;color:var(--a-ink);word-break:break-word}
.object-list-title{font-weight:var(--a-weight-regular)}

/* 借 ui-button-reset 清样式的列表行/卡片，不是按键，保持直角。 */
.inspection-row.inspection-row{border-radius:0!important}

/* 借 ui-button-reset 清样式的列表行/卡片，不是按键，保持直角。 */
.share-panel__choice.share-panel__choice{border-radius:0!important}

/* 「报告 / 巡查记录」切换：报告 tab 与巡查记录页共用。
   报告 tab 是底部 tab 页，切到记录页用 navigateTo（记录页是子页面，符合全站结构）。 */
.record-scope{display:flex;gap:var(--a-space-1);padding:var(--a-space-1);margin-bottom:var(--a-space-2);border:1px solid var(--a-line);border-radius:var(--a-radius-pill);background:var(--a-field)}
.record-scope__option{flex:1;width:auto!important;min-height:var(--a-hit);margin:0!important;padding:0 var(--a-space-2)!important;display:flex;align-items:center;justify-content:center;border-radius:var(--a-radius-pill);background:transparent;color:var(--a-muted);font-size:var(--a-type-medium);line-height:1.35}
.record-scope__option--active{background:var(--a-paper);color:var(--a-ink);font-weight:var(--a-weight-medium)}
