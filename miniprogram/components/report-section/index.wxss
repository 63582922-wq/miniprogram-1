.report-section{padding:24rpx 0;border-bottom:1px solid var(--a-line);display:flex;flex-direction:column;gap:10rpx;background:transparent;border-radius:0;box-shadow:none;font-family:var(--a-font-body,-apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans CJK SC","Microsoft YaHei","Helvetica Neue",sans-serif)}

.report-section__title {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
  letter-spacing: 0.04em;
}

.report-section__content {
  font-size: 26rpx;
  color: var(--a-muted, #706D67);
  line-height: 1.7;
  white-space: pre-wrap;
}
