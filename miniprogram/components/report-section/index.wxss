.report-section{padding:var(--a-space-3) 0;display:flex;flex-direction:column;gap:var(--a-space-1);background:transparent;border-radius:0;box-shadow:none;font-family:var(--a-font-body)}

.report-section__title {
  font-size: var(--a-type-object);
  font-weight:var(--a-weight-regular);
  color: var(--a-ink);
  line-height: 1.35;
}

.report-section__content {
  font-size: var(--a-type-body);
  color: var(--a-ink);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
@import "../../styles/precision-a.wxss";
