.report-section {
  background: #F2EDE4;
  border-radius: 4rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border: none;
  box-shadow: none;
}

.report-section__title {
  font-size: 30rpx;
  font-weight: 400;
  color: #1A1814;
  letter-spacing: 0.04em;
}

.report-section__content {
  font-size: 22rpx;
  color: #6B6355;
  line-height: 1.7;
  white-space: pre-wrap;
}
