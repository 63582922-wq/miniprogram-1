:host{display:block;position:sticky;top:0;z-index:50;margin:-16rpx calc(-1 * var(--a-page-inset)) 0}
.page-nav-bar{display:block;padding-left:24rpx;background:var(--a-paper);border-bottom:1px solid var(--a-line);box-sizing:border-box;color:var(--a-ink);font-family:var(--a-font-body,-apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans CJK SC","Microsoft YaHei","Helvetica Neue",sans-serif)}
.page-nav-bar__content{display:flex;align-items:center;gap:16rpx;box-sizing:border-box;min-width:0}
.page-nav-bar__back{min-width:88rpx;min-height:44px;padding:0 12rpx;display:flex;align-items:center;justify-content:center;gap:6rpx;background:transparent;color:var(--a-ink);border:0;font-size:26rpx;margin:0;flex-shrink:0;line-height:1.2}
.page-nav-bar__back:after{border:0}.page-nav-bar__icon{width:32rpx;height:32rpx}
.page-nav-bar__title{font-size:30rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;font-weight:600;letter-spacing:-.3rpx}
.page-nav-bar__title--brand{font-family:var(--a-font-display);font-size:32rpx;font-weight:500;letter-spacing:.5rpx}
.page-nav-bar .page-nav-bar__back{width:auto;flex:0 0 auto;margin:0}
.privacy-mask{position:fixed;top:0;bottom:0;left:0;right:0;z-index:999;background:rgba(25,24,22,.45);display:flex;align-items:center;justify-content:center}.privacy-dialog{width:85%;padding:32rpx;background:var(--a-paper);color:var(--a-ink);border-radius:var(--a-radius-object)}.privacy-title{font-size:34rpx;font-weight:600}.privacy-copy{font-size:28rpx;line-height:1.7;margin-top:20rpx;color:var(--a-muted)}.privacy-link{width:100%;min-height:44px;font-size:28rpx;background:transparent;margin:12rpx 0;color:var(--a-ink)}.privacy-agree{width:100%;min-height:48px;font-size:30rpx;background:var(--a-accent);color:var(--a-accent-ink);border:0;border-radius:var(--a-radius-control)}
