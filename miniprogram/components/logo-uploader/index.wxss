.logo-card{display:flex;align-items:center;gap:20rpx;padding:0 0 24rpx;margin-bottom:28rpx;border-bottom:1px solid var(--a-line);background:transparent;border-radius:0;font-family:var(--a-font-body,-apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans CJK SC","Microsoft YaHei","Helvetica Neue",sans-serif)}.logo-copy{flex:1;min-width:0}.logo-title{font-size:30rpx;font-weight:600;color:var(--a-ink)}.logo-hint{font-size:26rpx;color:var(--a-muted);margin-top:4rpx}.logo-preview{width:96rpx;height:96rpx;background:var(--a-field);flex-shrink:0;border:1px solid var(--a-line)}.logo-card .logo-button{width:auto;margin:0;min-height:44px;padding:14rpx 20rpx;border:1px solid var(--a-line);background:transparent;color:var(--a-active);font-family:var(--a-font-body,-apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans CJK SC","Microsoft YaHei","Helvetica Neue",sans-serif);font-size:28rpx;border-radius:var(--a-radius-control);line-height:1.4}.logo-button:after{border:0}
