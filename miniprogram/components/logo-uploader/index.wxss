.logo-card{display:flex;align-items:center;gap:var(--a-space-2);padding:0 0 var(--a-space-3);margin-bottom:var(--a-space-4);background:transparent;border-radius:0;font-family:var(--a-font-body)}.logo-copy{flex:1;min-width:0}.logo-title{font-size:var(--a-type-action);font-weight:var(--a-weight-emphasis);color:var(--a-ink)}.logo-hint{font-size:var(--a-type-caption);color:var(--a-muted);margin-top:var(--a-space-1)}.logo-preview{width:96rpx;height:96rpx;background:var(--a-field);flex-shrink:0;border:1px solid var(--a-line)}.logo-preview--unavailable{display:flex;align-items:center;justify-content:center;color:var(--a-muted);font-size:var(--a-type-caption);letter-spacing:.06em}.logo-card .logo-button{width:auto;margin:0;min-height:var(--a-hit);padding:var(--a-space-2) var(--a-space-2);border:1px solid var(--a-line);background:transparent;color:var(--a-active);font-family:var(--a-font-body);font-size:var(--a-type-medium);border-radius:var(--a-radius-control);line-height:1.4}.logo-button:after{border:0}
@import "../../styles/precision-a.wxss";
