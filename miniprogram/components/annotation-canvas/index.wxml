<view class="annotation-card">
 <view class="annotation-status"><text>{{workingSize ? '原图已适配' : '正在载入照片'}}</text><text>{{zoom}}%</text></view>
 <view wx:if="{{error}}" class="annotation-error">{{error}}<button class="ui-button-reset" bindtap="loadImage">重新加载</button></view>
 <canvas id="stage" type="2d" class="canvas-stage" bindtouchstart="start" catchtouchmove="move" bindtouchend="end" bindtouchcancel="end"></canvas>
 <canvas id="export" type="2d" class="export-canvas"></canvas>
 <view class="annotation-tool-rail">
  <button class="ui-button-reset tool {{tool==='select'?'tool--active':''}}" data-tool="select" bindtap="setTool"><image class="tool__icon" src="/images/icons/annotation-select.svg" mode="aspectFit"/><text>选择</text></button>
  <button class="ui-button-reset tool {{tool==='box'||tool==='ellipse'?'tool--active':''}}" bindtap="chooseRegionType"><image class="tool__icon" src="{{tool==='ellipse'?'/images/icons/annotation-circle.svg':'/images/icons/annotation-rectangle.svg'}}" mode="aspectFit"/><text>选区</text></button>
 </view>
 <view class="annotation-subrail">
  <button class="ui-button-reset tool tool--compact {{!canUndo?'tool--disabled':''}}" disabled="{{!canUndo}}" bindtap="undo"><image class="tool__icon" src="/images/icons/annotation-undo.svg" mode="aspectFit"/><text>撤销</text></button>
  <button class="ui-button-reset tool tool--compact {{!canRedo?'tool--disabled':''}}" disabled="{{!canRedo}}" bindtap="redo"><image class="tool__icon" src="/images/icons/annotation-redo.svg" mode="aspectFit"/><text>重做</text></button>
  <button class="ui-button-reset tool tool--compact {{tool==='pan'?'tool--active':''}}" data-tool="pan" bindtap="setTool"><image class="tool__icon" src="/images/icons/annotation-pan.svg" mode="aspectFit"/><text>拖图</text></button>
  <button class="ui-button-reset tool tool--compact" bindtap="fit"><image class="tool__icon" src="/images/icons/annotation-fit.svg" mode="aspectFit"/><text>适配</text></button>
 </view>
 <view class="annotation-help">
  <text wx:if="{{tool === 'box'||tool === 'ellipse'}}">拖动划出带编号选区 · 再拖边角调整大小</text>
  <text wx:elif="{{tool === 'pan'}}">单指拖图 · 双指缩放和移动</text>
  <text wx:elif="{{tool === 'select'}}">点选标注 · 拖动调整位置或范围</text>
  <text wx:else>拖动照片，圈出或指明问题位置</text>
 </view>
 <cover-view wx:if="{{regionChoiceOpen}}" class="region-choice" bindtap="closeRegionChoice">
  <cover-view class="region-choice__sheet">
   <cover-view class="region-choice__grabber"></cover-view>
   <cover-view class="region-choice__title">选择标注范围</cover-view>
   <cover-view class="region-choice__option {{tool==='box'?'region-choice__option--active':''}}" bindtap="chooseBoxRegion"><cover-image class="region-choice__icon" src="/images/icons/annotation-rectangle.svg"/><cover-view class="region-choice__copy"><cover-view class="region-choice__name">矩形</cover-view><cover-view class="region-choice__hint">适合门缝、边缘与长条区域</cover-view></cover-view><cover-view wx:if="{{tool==='box'}}" class="region-choice__current">当前</cover-view></cover-view>
   <cover-view class="region-choice__option {{tool==='ellipse'?'region-choice__option--active':''}}" bindtap="chooseEllipseRegion"><cover-image class="region-choice__icon" src="/images/icons/annotation-circle.svg"/><cover-view class="region-choice__copy"><cover-view class="region-choice__name">椭圆</cover-view><cover-view class="region-choice__hint">适合局部瑕疵与不规则范围</cover-view></cover-view><cover-view wx:if="{{tool==='ellipse'}}" class="region-choice__current">当前</cover-view></cover-view>
   <cover-view class="region-choice__cancel" bindtap="closeRegionChoice">取消</cover-view>
  </cover-view>
 </cover-view>
</view>
