<view class="annotation-card">
 <view class="annotation-status"><text>{{workingSize ? '原图已适配' : '正在载入照片'}}</text><text>{{zoom}}%</text></view>
 <view wx:if="{{error}}" class="annotation-error">{{error}}<button bindtap="loadImage">重新加载</button></view>
 <canvas id="stage" type="2d" class="canvas-stage" bindtouchstart="start" catchtouchmove="move" bindtouchend="end" bindtouchcancel="end"></canvas>
 <canvas id="export" type="2d" class="export-canvas"></canvas>
 <view class="annotation-tool-rail">
  <button class="tool {{tool==='select'?'tool--active':''}}" data-tool="select" bindtap="setTool"><image class="tool__icon" src="/images/icons/annotation-select.svg" mode="aspectFit"/><text>选择</text></button>
  <button class="tool {{tool==='box'?'tool--active':''}}" data-tool="box" bindtap="setTool"><image class="tool__icon" src="/images/icons/annotation-rectangle.svg" mode="aspectFit"/><text>框选</text></button>
  <button class="tool {{tool==='ellipse'?'tool--active':''}}" data-tool="ellipse" bindtap="setTool"><image class="tool__icon" src="/images/icons/annotation-circle.svg" mode="aspectFit"/><text>圈选</text></button>
  <button class="tool {{tool==='arrow'?'tool--active':''}}" data-tool="arrow" bindtap="setTool"><image class="tool__icon" src="/images/icons/annotation-arrow.svg" mode="aspectFit"/><text>箭头</text></button>
  <button class="tool {{tool==='point'?'tool--active':''}}" data-tool="point" bindtap="setTool"><image class="tool__icon" src="/images/icons/annotation-number.svg" mode="aspectFit"/><text>编号</text></button>
 </view>
 <view class="annotation-subrail">
  <button class="tool tool--compact {{tool==='pan'?'tool--active':''}}" data-tool="pan" bindtap="setTool"><image class="tool__icon" src="/images/icons/annotation-pan.svg" mode="aspectFit"/><text>移动</text></button>
  <button class="tool tool--compact {{!canUndo ? 'tool--disabled' : ''}}" bindtap="undo" disabled="{{!canUndo}}"><image class="tool__icon" src="/images/icons/annotation-undo.svg" mode="aspectFit"/><text>撤销</text></button>
  <button class="tool tool--compact {{!canRedo ? 'tool--disabled' : ''}}" bindtap="redo" disabled="{{!canRedo}}"><image class="tool__icon" src="/images/icons/annotation-redo.svg" mode="aspectFit"/><text>重做</text></button>
  <button class="tool tool--compact" data-factor="1.5" bindtap="zoom"><image class="tool__icon" src="/images/icons/annotation-zoom-in.svg" mode="aspectFit"/><text>放大</text></button>
  <button class="tool tool--compact" bindtap="fit"><image class="tool__icon" src="/images/icons/annotation-fit.svg" mode="aspectFit"/><text>全图</text></button>
  <button class="tool tool--compact {{!selected ? 'tool--disabled' : ''}}" bindtap="remove" disabled="{{!selected}}"><image class="tool__icon" src="/images/icons/annotation-delete.svg" mode="aspectFit"/><text>删除</text></button>
 </view>
 <view wx:if="{{selected}}" class="annotation-nudge">
  <text class="annotation-nudge__label">微调位置</text>
  <button class="nudge-button" aria-label="向左微调" data-delta="-1,0" bindtap="nudge"><image class="nudge-button__icon" src="/images/icons/annotation-left.svg" mode="aspectFit"/></button>
  <button class="nudge-button" aria-label="向右微调" data-delta="1,0" bindtap="nudge"><image class="nudge-button__icon" src="/images/icons/annotation-right.svg" mode="aspectFit"/></button>
  <button class="nudge-button" aria-label="向上微调" data-delta="0,-1" bindtap="nudge"><image class="nudge-button__icon" src="/images/icons/annotation-up.svg" mode="aspectFit"/></button>
  <button class="nudge-button" aria-label="向下微调" data-delta="0,1" bindtap="nudge"><image class="nudge-button__icon" src="/images/icons/annotation-down.svg" mode="aspectFit"/></button>
 </view>
 <view class="annotation-help">双指缩放；选中标记后可拖动或调整端点</view>
</view>
