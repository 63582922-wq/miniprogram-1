.annotation-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-height: 100%;
}

.canvas-stage {
  width: 100%;
  position: relative;
  flex: 1;
  min-height: 900rpx;
  background: #1C1C1E;
  border-radius: 4rpx;
  overflow: hidden;
}

.canvas-viewport {
  position: absolute;
  inset: 0;
}

.canvas-image {
  width: 100%;
  height: 100%;
  display: block;
}

.canvas-overlay {
  position: absolute;
  inset: 0;
}

.mark {
  position: absolute;
  box-sizing: border-box;
}

.mark--box {
  border: 4rpx solid #B8A882;
  border-radius: 0;
}

.mark--arrow {
  height: 8rpx;
  background: #B8A882;
  border: none;
  border-radius: 0;
  transform-origin: 0 50%;
}

.mark__arrow-head {
  position: absolute;
  right: -18rpx;
  top: 50%;
  width: 0;
  height: 0;
  transform: translateY(-50%);
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 20rpx solid #B8A882;
}

.mark--text {
  width: auto;
  min-width: 96rpx;
  height: auto;
  padding: 10rpx 18rpx;
  border: none;
  background: rgba(26, 24, 20, 0.94);
  color: #FAF9F7;
  font-size: 22rpx;
  border-radius: 0;
  transform: translate(-50%, -50%);
}

.mark--preview {
  opacity: 0.65;
  border-style: dashed;
}

.annotation-empty {
  border-radius: 4rpx;
  background: #F2EDE4;
  padding: 160rpx 24rpx;
  text-align: center;
  color: #6B6355;
  border: none;
  box-shadow: none;
}

.annotation-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tool {
  min-width: calc((100% - 24rpx) / 3);
  height: 68rpx;
  padding: 0 18rpx;
  background: transparent;
  border: 0.5px solid #E8E2D8;
  border-radius: 0;
  color: #6B6355;
  font-size: 22rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.tool--active {
  background: #1A1814;
  color: #D4C5A0;
  border-color: #1A1814;
}

.tool--muted {
  background: transparent;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.text-editor-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.32);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  z-index: 20;
}

.text-editor {
  width: 100%;
  background: #F2EDE4;
  border-radius: 4rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.text-editor__title {
  font-size: 26rpx;
  font-weight: 400;
  color: #1A1814;
}

.text-editor__input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 0;
  border-radius: 0;
  border: none;
  border-bottom: 0.5px solid #E8E2D8;
  background: transparent;
  color: #1A1814;
  font-size: 22rpx;
  box-sizing: border-box;
}

.text-editor__actions {
  display: flex;
  gap: 16rpx;
}

.text-editor__button {
  flex: 1;
  height: 80rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 400;
}

.text-editor__button--ghost {
  background: transparent;
  color: #6B6355;
  border: 0.5px solid #B8A882;
}

.text-editor__button--primary {
  background: #1A1814;
  color: #D4C5A0;
  border: none;
}
