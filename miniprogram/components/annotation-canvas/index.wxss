.annotation-card {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  background: var(--a-paper);
  color: var(--a-ink);
  font-family: var(--a-font-body);
}

.canvas-stage {
  display: block;
  width: 100%;
  height: auto;
  min-height: 240px;
  flex: 1 1 auto;
  background: var(--a-photo-matte);
  touch-action: none;
}

.annotation-status {
  display: flex;
  min-height: var(--a-hit);
  align-items: center;
  justify-content: space-between;
  padding: var(--a-space-1) var(--a-space-2);

  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.4;
}

.annotation-tool-rail,
.annotation-subrail {
  display: flex;
  align-items: stretch;
  padding: var(--a-space-1) var(--a-space-1);

  background: var(--a-paper);
}

.annotation-tool-rail .tool,
.annotation-subrail .tool {
  flex: 1;
}

.tool {
  position: relative;
  display: flex;
  min-width: 44px;
  min-height: var(--a-hit-primary);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--a-space-1);
  margin: 0;
  padding: var(--a-space-1) var(--a-space-1);
  border: 0;
  border-radius: var(--a-radius-control);
  background: transparent;
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-size: var(--a-type-caption);
  font-weight:var(--a-weight-medium);
  line-height: 1.25;
  transition: background-color var(--a-motion), color var(--a-motion), opacity var(--a-motion);
}

.tool::after {
  border: 0;
}

.tool--active {
  background: var(--a-accent-wash);
  color: var(--a-accent-text);
}

.tool--active::before {
  position: absolute;
  bottom: 3rpx;
  left: 50%;
  width: 28rpx;
  height: 4rpx;
  border-radius: var(--a-radius-mark);
  background: var(--a-accent);
  content: "";
  transform: translateX(-50%);
}

.tool--disabled {
  opacity: var(--a-state-disabled);
  background: transparent !important;
  color: var(--a-ink) !important;
}

.tool__icon {
  display: block;
  width: var(--a-icon);
  height: var(--a-icon);
  flex: none;
}

.annotation-tool-rail .tool__icon {
  width: var(--a-icon-lg);
  height: var(--a-icon-lg);
}

.annotation-subrail {
  padding-top: var(--a-space-1);
  padding-bottom: var(--a-space-1);
}

.annotation-subrail .tool {
  min-height: var(--a-hit-compact);
  font-size: var(--a-type-micro);
}

.annotation-subrail .tool__icon {
  width: var(--a-icon-sm);
  height: var(--a-icon-sm);
}

.annotation-help {
  min-height: 40rpx;
  padding: var(--a-space-1) var(--a-space-2) var(--a-space-1);
  color: var(--a-muted);
  font-size: var(--a-type-micro);
  line-height: 1.4;
  text-align: center;
}

.annotation-error {
  padding: var(--a-space-2);
  background: var(--a-danger-surface);
  color: var(--a-danger);
  font-size: var(--a-type-meta);
}

.export-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 1px;
  height: 1px;
}

.region-choice{position:fixed;z-index:999;top:0;right:0;bottom:0;left:0;background:var(--a-scrim);}
.region-choice__sheet{position:absolute;right:0;bottom:0;left:0;box-sizing:border-box;padding:var(--a-space-3) var(--a-page-inset) calc(var(--a-space-3) + env(safe-area-inset-bottom));border:1px solid var(--a-line);border-bottom:0;border-radius:var(--a-radius-sheet) var(--a-radius-sheet) 0 0;background:var(--a-paper);color:var(--a-ink);}
.region-choice__grabber{width:var(--a-space-8);height:var(--a-space-1);margin:0 auto var(--a-space-3);border-radius:var(--a-radius-pill);background:var(--a-line-strong);}
.region-choice__title{height:var(--a-space-7);margin-bottom:var(--a-space-1);font-size:var(--a-type-section);font-weight:var(--a-weight-emphasis);line-height:var(--a-space-7);text-align:center;}
.region-choice__option{position:relative;box-sizing:border-box;width:100%;height:calc(var(--a-space-7) * 2);margin:0;padding:0;background:transparent;color:var(--a-ink);}
.region-choice__option--active{background:var(--a-accent-wash);}
.region-choice__icon{position:absolute;top:var(--a-space-4);left:0;width:var(--a-icon-lg);height:var(--a-icon-lg);}
.region-choice__copy{position:absolute;top:var(--a-space-2);right:var(--a-space-10);left:var(--a-space-8);}
.region-choice__name{font-size:var(--a-type-body);font-weight:var(--a-weight-medium);line-height:1.2;}
.region-choice__hint{color:var(--a-muted);font-size:var(--a-type-caption);line-height:1.3;}
.region-choice__current{position:absolute;top:var(--a-space-4);right:0;min-width:var(--a-space-7);height:var(--a-hit);padding:0 var(--a-space-2);border-radius:var(--a-radius-pill);background:var(--a-accent);color:var(--a-accent-ink);font-size:var(--a-type-caption);line-height:var(--a-hit);text-align:center;}
.region-choice__cancel{box-sizing:border-box;width:100%;height:var(--a-hit);margin-top:var(--a-space-3);padding:0;border-radius:var(--a-radius-control);background:var(--a-surface);color:var(--a-ink);font-size:var(--a-type-action);line-height:var(--a-hit);text-align:center;}
@import "../../styles/precision-a.wxss";
