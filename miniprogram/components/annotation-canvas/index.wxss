.annotation-card {
  overflow: hidden;
  background: var(--a-paper);
  color: var(--a-ink);
  font-family: var(--a-font-body, -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", "Helvetica Neue", sans-serif);
}

.canvas-stage {
  display: block;
  width: 100%;
  height: 54vh;
  min-height: 340px;
  background: var(--a-photo-matte);
}

.annotation-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 42rpx;
  padding: 14rpx 20rpx;
  background: var(--a-paper);
  color: var(--a-muted);
  border-bottom: 1px solid var(--a-line);
  font-size: 26rpx;
  line-height: 1.5;
}

.annotation-tool-rail,
.annotation-subrail,
.annotation-nudge {
  display: flex;
  align-items: center;
  padding: 8rpx 10rpx;
  border-top: 1px solid var(--a-line);
  background: var(--a-paper);
}

.annotation-tool-rail .tool,
.annotation-subrail .tool {
  flex: 1;
}

.tool {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 50px;
  margin: 0;
  padding: 8rpx 2rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--a-ink);
  font-size: 26rpx;
  font-family: var(--a-font-body, -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", "Helvetica Neue", sans-serif);
  font-weight: 500;
  line-height: 1.2;
}

.tool--active {
  color: var(--a-accent-text);
}

.tool--active::after {
  position: absolute;
  bottom: 1rpx;
  left: 50%;
  width: 22rpx;
  height: 3rpx;
  border: 0;
  border-radius: 2rpx;
  background: var(--a-accent);
  content: "";
  transform: translateX(-50%);
}

.tool--active .tool__icon {
  filter: brightness(0) saturate(100%) invert(44%) sepia(71%) saturate(1127%) hue-rotate(333deg) brightness(98%) contrast(82%);
}

.tool--disabled {
  opacity: 0.26;
  background: transparent !important;
  color: var(--a-muted) !important;
}

.tool::after {
  border: 0;
}

.tool__icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.annotation-tool-rail .tool__icon {
  width: 42rpx;
  height: 42rpx;
}

.annotation-subrail {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}

.annotation-subrail .tool {
  min-height: 46px;
  font-size: 26rpx;
}

.annotation-subrail .tool__icon {
  width: 36rpx;
  height: 36rpx;
}

.annotation-nudge {
  gap: 8rpx;
  background: var(--a-field);
}

.annotation-nudge__label {
  margin-right: auto;
  padding: 0 12rpx 0 10rpx;
  color: var(--a-muted);
  font-size: 26rpx;
  letter-spacing: 0.08em;
}

.nudge-button {
  flex: 0 0 44px;
  width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--a-line);
  border-radius: var(--a-radius-control);
  background: transparent;
}

.nudge-button::after {
  border: 0;
}

.nudge-button__icon {
  width: 32rpx;
  height: 32rpx;
}

.annotation-help {
  padding: 10rpx 20rpx 16rpx;
  color: var(--a-muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.annotation-error {
  padding: 20rpx;
  background: #f2ddd8;
  color: var(--a-danger);
  font-size: 28rpx;
}

.export-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 1px;
  height: 1px;
}
