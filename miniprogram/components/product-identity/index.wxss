.product-identity-spacer{height:56px}
.product-identity{position:fixed;top:0;left:0;right:0;z-index:45;display:flex;align-items:center;gap:var(--a-space-2);height:56px;box-sizing:content-box;padding-left:var(--a-page-inset);background:var(--a-paper);color:var(--a-ink);font-family:var(--a-font-body)}
.product-identity__mark{width:72rpx;height:72rpx;flex:none;border-radius:var(--a-radius-brand);overflow:hidden}
.product-identity__copy{min-width:0}
.product-identity__name{font-family:var(--a-font-body);font-size:var(--a-type-object);font-weight:var(--a-weight-medium);letter-spacing:0;line-height:1.15}
.product-identity__title{position:absolute;bottom:0;display:flex;align-items:center;justify-content:center;overflow:hidden;white-space:nowrap;font-size:var(--a-type-body);font-weight:var(--a-weight-medium);line-height:1.35;text-align:center;pointer-events:none}
@import "../../styles/precision-a.wxss";
