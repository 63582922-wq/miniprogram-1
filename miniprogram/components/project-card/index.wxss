.project-card {
  background: #F2EDE4;
  border-radius: 4rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border: none;
  box-shadow: none;
}

.project-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.project-card__header-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.project-card__name {
  font-size: 30rpx;
  font-weight: 400;
  color: #1A1814;
  letter-spacing: 0.04em;
}

.project-card__meta {
  font-size: 20rpx;
  color: #6B6355;
  line-height: 1.4;
  font-weight: 400;
}

.project-card__client {
  font-size: 20rpx;
  color: #6B6355;
  font-weight: 400;
}

.project-card__stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.project-card__stat {
  min-height: 84rpx;
  border-radius: 2rpx;
  padding: 14rpx 14rpx;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid #E8E2D8;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6rpx;
}

.project-card__stat--wide {
  grid-column: span 1;
}

.project-card__stat-value {
  font-size: 26rpx;
  font-weight: 400;
  color: #1A1814;
  font-variant-numeric: tabular-nums;
}

.project-card__stat-value--small {
  font-size: 20rpx;
  line-height: 1.3;
}

.project-card__stat-label {
  font-size: 18rpx;
  font-weight: 400;
  color: #6B6355;
}

.project-card__arrow {
  width: 12rpx;
  height: 12rpx;
  margin-top: 6rpx;
  border-top: 3rpx solid #B8A882;
  border-right: 3rpx solid #B8A882;
  transform: rotate(45deg);
}
