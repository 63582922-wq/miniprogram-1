:host{display:block;width:100%}
.project-card{width:100%!important;margin:0!important;padding:var(--a-space-4) 0!important;display:flex;flex-direction:column;gap:var(--a-space-2);background:transparent;border:0;border-radius:0;box-shadow:none;text-align:left;font-family:var(--a-font-body);line-height:normal;color:inherit;transition:opacity var(--a-motion),transform var(--a-motion)}
.project-card::after{border:0}.project-card--pressed{opacity:var(--a-state-pressed);transform:scale(.995)}
.project-card__header{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--a-space-2);width:100%}
.project-card__header-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:var(--a-space-1)}
.project-card__name-line{display:flex;align-items:baseline;gap:var(--a-space-2);min-width:0}
.project-card__name{min-width:0}
.project-card__test-label{flex:none;padding:var(--a-space-1) var(--a-space-2);border-radius:var(--a-radius-pill);background:var(--a-ai-wash);color:var(--a-muted);font-size:var(--a-type-micro);font-weight:var(--a-weight-medium);line-height:1.5}
.project-card__meta,.project-card__client{font-size:var(--a-type-caption);color:var(--a-muted);line-height:1.45;font-weight:var(--a-weight-regular);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.project-card__stats{display:flex;align-items:baseline;justify-content:space-between;gap:var(--a-space-2);padding-top:var(--a-space-1);width:100%}
.project-card__stat-summary{display:flex;align-items:baseline;gap:var(--a-space-1);min-width:0;white-space:nowrap;color:var(--a-muted)}
.project-card__stat-value{font-size:var(--a-type-meta);font-weight:var(--a-weight-emphasis);color:var(--a-ink);font-variant-numeric:tabular-nums}
.project-card__stat-label{font-size:var(--a-type-caption);color:var(--a-muted)}
.project-card__stat-separator{margin:0 var(--a-space-1);color:var(--a-line)}
.project-card__date{margin-left:auto;color:var(--a-muted);font-size:var(--a-type-caption);white-space:nowrap;font-variant-numeric:tabular-nums}
.project-card__arrow{width:12rpx;height:12rpx;margin:var(--a-space-1) var(--a-space-1) 0 0;border-top:2rpx solid var(--a-muted);border-right:2rpx solid var(--a-muted);transform:rotate(45deg);flex:none}
@import "../../styles/precision-a.wxss";

/* 借 ui-button-reset 清样式的列表行/卡片，不是按键，保持直角。 */
.project-card.project-card{border-radius:0!important}
