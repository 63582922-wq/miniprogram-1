<button class="project-card" bindtap="handleTap" bindlongpress="handleLongPress" hover-class="project-card--pressed">
  <view class="project-card__header">
    <view class="project-card__header-main">
      <view class="project-card__name">{{project.name}}</view>
      <view class="project-card__meta">{{project.address}}</view>
    </view>
    <view class="project-card__arrow"></view>
  </view>
  <view wx:if="{{project.clientName}}" class="project-card__client">甲方 · {{clientNameText}}</view>
  <view class="project-card__stats">
    <view class="project-card__stat-summary">
      <text class="project-card__stat-value">{{inspectionsCount}}</text><text class="project-card__stat-label">次记录</text>
      <text class="project-card__stat-separator">·</text>
      <text class="project-card__stat-value">{{issuesCount}}</text><text class="project-card__stat-label">个问题</text>
    </view>
    <view class="project-card__date">{{inspectionsCount ? '最近 ' : '创建 '}}{{dateText}}</view>
  </view>
</button>
