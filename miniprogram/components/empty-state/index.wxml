<view class="empty-state">
  <image class="empty-state__icon" src="/images/icons/nav-plus.svg" mode="aspectFit" />
  <view class="empty-state__title">{{title}}</view>
  <view wx:if="{{description}}" class="empty-state__description">{{description}}</view>
  <view wx:if="{{actionText}}" class="empty-state__action" bindtap="handleAction">{{actionText}}</view>
</view>
