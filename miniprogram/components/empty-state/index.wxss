.empty-state {
  padding: var(--a-space-7) var(--a-space-3);
  border-radius: var(--a-radius-tight);
  background: transparent;
  text-align: center;
  border: none;
  font-family: var(--a-font-body);
}

.empty-state__title {
  font-family: var(--a-font-body);
  font-size:var(--a-type-action);
  font-weight:var(--a-weight-emphasis);
  color: var(--a-ink);
  letter-spacing: 0.04em;
}

.empty-state__description {
  margin-top: var(--a-space-2);
  font-size:var(--a-type-caption);
  color: var(--a-muted);
  line-height: 1.6;
}

/* 空态的主操作：没有它，冷启动就是一条死路 */
.empty-state__action {
  width: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: var(--a-space-4) auto 0;
  padding: 0 var(--a-space-7);
  min-height: var(--a-hit-primary);
  background: var(--a-accent);
  color: var(--a-accent-ink);
  font-size:var(--a-type-action);
  letter-spacing: 0;
}

.empty-state__action::after {
  border: 0;
}

.empty-state__action:active {
  opacity: 0.85;
}
@import "../../styles/precision-a.wxss";

.empty-state__action{border-radius:var(--a-radius-pill)}
