.voice-card {
  background: transparent;
  border-radius: 0;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border: none;
  border-bottom: 1px solid var(--a-line, #C9C1B7);
  box-shadow: none;
  font-family: var(--a-font-body, -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", "Helvetica Neue", sans-serif);
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.voice-title {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
}

.voice-hold-button {
  width: 100%;
  height: 96rpx;
  margin: 0 auto 16rpx;
  padding: 0 28rpx;
  background: var(--a-accent);
  color: var(--a-accent-ink);
  border: none;
  border-radius: var(--a-radius-control);
  font-size: 26rpx;
  font-weight: 400;
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  letter-spacing: 0.2em;
}

.voice-hold-button::after {
  border: none;
}

.voice-hold-button--active {
  background: var(--a-accent-strong);
  color: var(--a-accent-ink);
  transform: scale(0.98);
}

.voice-hold-button__mic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.voice-hold-button__text {
  font-size: 26rpx;
  line-height: 1;
  transform: translateY(2rpx);
}

.voice-tip {
  font-size: 26rpx;
  color: var(--a-muted, #706D67);
  line-height: 1.6;
}

.voice-textarea {
  width: 100%;
  min-height: 180rpx;
  border-radius: 0;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid var(--a-line, #C9C1B7);
  padding: 24rpx 0;
  color: var(--a-ink, #191816);
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
