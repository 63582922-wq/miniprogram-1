.voice-card {
  background: transparent;
  border-radius: 0;
  padding: var(--a-space-3) 0;
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
  border: none;

  box-shadow: none;
  font-family: var(--a-font-body);
}

.voice-title {
  font-size:var(--a-type-caption);
  font-weight:var(--a-weight-regular);
  color: var(--a-ink);
}

.voice-hold-button {
  width: 100%;
  height: 96rpx;
  margin: 0 auto var(--a-space-2);
  padding: 0 var(--a-space-4);
  background: var(--a-accent);
  color: var(--a-accent-ink);
  border: none;
  border-radius: var(--a-radius-pill);
  font-size:var(--a-type-caption);
  font-weight:var(--a-weight-regular);
  display: flex;
  flex-direction: row;
  gap: var(--a-space-2);
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  letter-spacing: 0.2em;
}

.voice-hold-button::after {
  border: none;
}

.voice-hold-button--active {
  background: var(--a-accent-strong);
  color: var(--a-accent-ink);
  transform: scale(0.98);
}

.voice-hold-button__mic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.voice-hold-button__text {
  font-size:var(--a-type-caption);
  line-height: 1;
  transform: translateY(2rpx);
}

.voice-tip {
  font-size:var(--a-type-caption);
  color: var(--a-muted);
  line-height: 1.6;
}

.voice-textarea {
  width: 100%;
  min-height: 180rpx;
  border-radius: 0;
  background: transparent;
  border: none;

  padding: var(--a-space-3) 0;
  color: var(--a-ink);
  font-size:var(--a-type-caption);
  line-height: 1.6;
  box-sizing: border-box;
}
@import "../../styles/precision-a.wxss";
