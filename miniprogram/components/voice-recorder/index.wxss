.voice-card {
  background: #F2EDE4;
  border-radius: 4rpx;
  padding: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border: none;
  box-shadow: none;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.voice-title {
  font-size: 26rpx;
  font-weight: 400;
  color: #1A1814;
}

.voice-hold-button {
  width: 100%;
  height: 96rpx;
  margin: 0 auto 16rpx;
  padding: 0 28rpx;
  background: #1A1814;
  color: #D4C5A0;
  border: none;
  border-radius: 0;
  font-size: 22rpx;
  font-weight: 400;
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  letter-spacing: 0.2em;
}

.voice-hold-button::after {
  border: none;
}

.voice-hold-button--active {
  background: #1A1814;
  color: #D4C5A0;
  transform: scale(0.98);
}

.voice-hold-button__mic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.voice-hold-button__text {
  font-size: 22rpx;
  line-height: 1;
  transform: translateY(2rpx);
}

.voice-tip {
  font-size: 20rpx;
  color: #6B6355;
  line-height: 1.6;
}

.voice-textarea {
  width: 100%;
  min-height: 180rpx;
  border-radius: 0;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid #E8E2D8;
  padding: 24rpx 0;
  color: #1A1814;
  font-size: 22rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
