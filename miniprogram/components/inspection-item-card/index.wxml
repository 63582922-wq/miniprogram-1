<view class="item-card">
  <view class="item-card__header">
    <view class="item-card__header-main">
      <view wx:if="{{showLeadingIndex && (item.description || item.markerNumber)}}" class="item-card__index">{{item.description ? (displayIndex || (index + 1))+'.' : '标注 '+item.markerNumber}}</view>
      <view wx:if="{{!hideTitle}}" class="item-card__title">{{resolvedTitle}}</view>
      <text wx:if="{{editable && item.needsReview}}" class="item-card__review-flag">{{item.unsupported ? 'AI 建议 · 无可见依据' : item.textOrganized ? '文字整理 · 待核对' : item.evidenceSource === 'image' || item.evidenceSource === 'image+note' ? 'AI识图 · 待核对' : 'AI建议 · 待核对'}}</text>
    </view>
    <button wx:if="{{editable}}" class="ui-button-reset item-card__action item-card__edit" bindtap="toggleEditing">{{editing ? '完成' : '修改'}}</button>
  </view>
  <view wx:if="{{!editable || !editing}}" class="item-card__read">
    <view class="item-card__description">{{item.description || '补充这处标注的说明'}}</view>
    <!-- 模型自己描述、但说不出依据的条目：留着供判断，但必须一眼看出来没有依据。 -->
    <view wx:if="{{item.unsupported}}" class="item-card__unsupported">这条没有可见依据，是 AI 自己描述的。请现场确认后再决定要不要保留；保留则照常写入报告。</view>
    <view wx:if="{{showSourceQuote}}" class="item-card__source">
      <button class="ui-button-reset item-card__source-toggle" aria-expanded="{{sourceQuoteExpanded}}" bindtap="toggleSourceQuote">{{sourceQuoteExpanded ? '收起原话' : '查看原话'}}</button>
      <view wx:if="{{sourceQuoteExpanded}}" class="item-card__source-quote">{{item.sourceQuote}}</view>
    </view>
    <view wx:if="{{item.suggestion}}" class="item-card__suggestion"><text class="item-card__label">处理建议</text> {{item.suggestion}}</view>
    <view wx:if="{{item.visualEvidence && !item.hideVisualEvidence}}" class="item-card__ai-evidence"><text class="item-card__ai-label">AI 观察</text><text>{{item.visualEvidence}}</text></view>
    <view wx:if="{{item.area || item.category || item.responsiblePartyName || (item.severity && item.severity !== 'normal') || (item.responsibleParty && item.responsibleParty !== 'pending')}}" class="item-card__summary-meta">
      <view wx:if="{{item.area}}" class="item-card__field-line"><text class="item-card__field-name">区域</text><text class="item-card__field-value">{{item.area}}</text></view>
      <view wx:if="{{item.category}}" class="item-card__field-line"><text class="item-card__field-name">分类</text><text class="item-card__field-value">{{item.category}}</text></view>
      <view wx:if="{{item.responsiblePartyName || (item.responsibleParty && item.responsibleParty !== 'pending')}}" class="item-card__field-line"><text class="item-card__field-name">责任方</text><text class="item-card__field-value">{{item.responsiblePartyName || responsiblePartyOptions[responsiblePartyIndex].label}}</text></view>
      <view wx:if="{{item.severity && item.severity !== 'normal'}}" class="item-card__field-line"><text class="item-card__field-name">等级</text><text class="item-card__field-value">{{severityText}}</text></view>
    </view>
  </view>
  <block wx:if="{{editable && editing}}">
    <textarea auto-height maxlength="5000" class="item-card__textarea" value="{{item.description}}" data-field="description" bindinput="handleChange" placeholder="这处有什么问题？" placeholder-class="ui-placeholder" />
    <button class="ui-button-reset item-card__action item-card__more" bindtap="toggleMetadata">{{metadataExpanded ? '收起补充信息' : '处理建议、位置等（选填）'}}</button>
    <view wx:if="{{metadataExpanded}}">
      <view class="item-card__section"><view class="item-card__label">处理建议</view><textarea auto-height maxlength="5000" class="item-card__textarea" value="{{item.suggestion}}" data-field="suggestion" bindinput="handleChange" placeholder="未填写则不在报告显示" placeholder-class="ui-placeholder" /></view>
      <view class="item-card__field-grid">
        <view class="item-card__row"><text class="item-card__label">严重级</text><picker mode="selector" range="{{severityOptions}}" range-key="label" value="{{severityIndex}}" bindchange="handleSeverityChange"><view class="item-card__picker">{{severityOptions[severityIndex].label}}</view></picker></view>
        <view class="item-card__row"><text class="item-card__label">责任方</text><input class="item-card__input" maxlength="120" value="{{item.responsiblePartyName || (item.responsibleParty !== 'pending' ? responsiblePartyOptions[responsiblePartyIndex].label : '')}}" data-field="responsiblePartyName" bindinput="handleChange" placeholder="原话未提及则留空" placeholder-class="ui-placeholder" /></view>
        <view class="item-card__row"><text class="item-card__label">区域</text><input class="item-card__input" value="{{item.area}}" data-field="area" bindinput="handleChange" placeholder-class="ui-placeholder" /></view>
        <view class="item-card__row"><text class="item-card__label">分类</text><input class="item-card__input" value="{{item.category}}" data-field="category" bindinput="handleChange" placeholder-class="ui-placeholder" /></view>
      </view>
      <view wx:if="{{item.visualEvidence}}" class="item-card__summary-meta">识别参考：{{item.visualEvidence}}</view>
      <view wx:if="{{item.originalText}}" class="item-card__summary-meta">原话：{{item.originalText}}</view>
    </view>
    <button class="ui-button-reset item-card__action item-card__delete" bindtap="deleteItem">删除这条</button>
  </block>
  <scroll-view wx:if="{{showImages && displayImages.length}}" class="item-card__image-scroll" scroll-x><view class="item-card__image-list"><image wx:for="{{displayImages}}" wx:key="*this" class="item-card__image" src="{{item}}" mode="aspectFill" /></view></scroll-view>
</view>
