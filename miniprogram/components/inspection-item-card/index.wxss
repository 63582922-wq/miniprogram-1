.item-card {
  background: var(--a-surface, #E2DCD3);
  border-radius: 0;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border: none;
  box-shadow: none;
  font-family: var(--a-font-body, -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", "Helvetica Neue", sans-serif);
}

.item-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-card__header-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-card__index {
  min-width: 34rpx;
  color: var(--a-muted, #706D67);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 0;
}

.item-card__title {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
  line-height: 1.2;
  letter-spacing: 0.04em;
}

.item-card__meta {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.item-card__badge {
  padding: 8rpx 18rpx;
  border-radius: 0;
  background: transparent;
  color: var(--a-muted, #706D67);
  font-size: 26rpx;
  font-weight: 400;
  border: 0.5px solid var(--a-line, #C9C1B7);
}

.item-card__row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.item-card__field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.item-card__section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.item-card__section-title {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
}

.item-card__label {
  font-size: 26rpx;
  color: var(--a-muted, #706D67);
  font-weight: 400;
}

.item-card__input,
.item-card__textarea,
.item-card__picker {
  width: 100%;
  border-radius: 0;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid var(--a-line, #C9C1B7);
  color: var(--a-ink, #191816);
  font-size: 26rpx;
}

.item-card__input,
.item-card__picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 0;
  box-sizing: border-box;
}

.item-card__picker {
  color: var(--a-ink, #191816);
}

.item-card__textarea {
  min-height: 120rpx;
  line-height: 1.6;
  padding: 18rpx 0;
  box-sizing: border-box;
}

.item-card__text {
  padding: 18rpx 0;
  border-radius: 0;
  background: transparent;
  border: none;
  color: var(--a-ink, #191816);
  font-size: 26rpx;
  line-height: 1.6;
}

.item-card__image-scroll {
  width: 100%;
  white-space: nowrap;
}

.item-card__image-list {
  display: inline-flex;
  gap: 12rpx;
}

.item-card__image-wrap {
  border-radius: 2rpx;
  overflow: hidden;
  border: none;
}

.item-card__image {
  width: 152rpx;
  height: 152rpx;
  background: var(--a-surface, #E2DCD3);
}

.item-card{position:relative;background:transparent;border:0;border-top:1px solid #C9C1B7;padding:24rpx 0;box-shadow:none;border-radius:0}
.item-card__edit{min-height:44px;display:flex;align-items:center;margin:0 0 16rpx auto;padding:0 20rpx;border:1px solid #C9C1B7;color:#191816;font-size:28rpx;background:transparent}
.item-card__description{font-size:32rpx;line-height:1.75;white-space:pre-wrap;word-break:break-word}.item-card__suggestion{font-size:30rpx;line-height:1.7;margin-top:16rpx;white-space:pre-wrap;word-break:break-word}.item-card__summary-meta{font-size:26rpx;color:#706D67;margin-top:16rpx}
.item-card__input,.item-card__textarea{font-size:32rpx;line-height:1.7;background:var(--a-field);padding:16rpx;min-height:48px;border:1px solid var(--a-line)}.item-card__picker{min-height:44px;display:flex;align-items:center}
