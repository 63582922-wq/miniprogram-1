@import "../../styles/precision-a.wxss";

.item-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
  padding: var(--a-space-3) 0;
  border: 0;

  border-radius: 0;
  background: transparent;
  box-shadow: none;
  font-family: var(--a-font-body);
}

.item-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--a-space-2);
}

.item-card__header-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: var(--a-space-2);
}

.item-card__index {
  display: flex;
  min-width: 34rpx;
  align-items: center;
  justify-content: center;
  color: var(--a-accent-text);
  font-size: var(--a-type-action);
  font-weight: var(--a-weight-regular);
  line-height: 1;
}

.item-card__title {
  color: var(--a-ink);
  font-size: var(--a-type-caption);
  font-weight: var(--a-weight-regular);
  line-height: 1.2;
  letter-spacing: 0.04em;
}

.item-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--a-space-1);
}

.item-card__badge {
  padding: var(--a-space-1) var(--a-space-2);
  border: 0.5px solid var(--a-line);
  border-radius: 0;
  background: transparent;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  font-weight: var(--a-weight-regular);
}

.item-card__section {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-1);
}

.item-card__row { display:flex; flex-direction:row; align-items:center; gap:var(--a-space-2); font-size:var(--a-type-body); }

.item-card__field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--a-space-2);
  margin-top: var(--a-space-3);
}

.item-card__section-title {
  color: var(--a-ink);
  font-size: var(--a-type-caption);
  font-weight: var(--a-weight-regular);
}

.item-card__label {
  flex:none;
  color: var(--a-muted);
  font-size: var(--a-type-body);
  font-weight: var(--a-weight-regular);
}

.item-card__input,
.item-card__textarea {
  flex:1;
  min-width:0;
  width: 100%;
  min-height: var(--a-hit-compact);
  box-sizing: border-box;
  padding: var(--a-space-2);
  border: 1px solid var(--a-line);
  border-radius: 0;
  background: var(--a-field);
  color: var(--a-ink);
  font-size: var(--a-type-body);
  line-height: 1.7;
}

.item-card__textarea {
  min-height: 120rpx;
}

.item-card__picker {
  display: flex;
  width: 100%;
  min-height: var(--a-hit);
  align-items: center;
  box-sizing: border-box;
  padding: 0;

  border-radius: 0;
  background: transparent;
  color: var(--a-ink);
  font-size: var(--a-type-caption);
  line-height: 1.5;
}

.item-card__text {
  padding: var(--a-space-2) 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--a-ink);
  font-size: var(--a-type-caption);
  line-height: 1.6;
}

.item-card__edit {
  flex: none;
  min-height: var(--a-hit);
  padding: 0 0 0 var(--a-space-2);
  border: 1px solid var(--a-line);
  background: transparent;
  color: var(--a-ink);
  font-size: var(--a-type-medium);
}

.item-card__description {
  color: var(--a-ink);
  font-size: var(--a-type-body);
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}

.item-card__source {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--a-space-1);
}

.item-card__source-toggle {
  width: auto;
  min-height: var(--a-hit);
  margin: 0;
  padding: 0 var(--a-space-1) 0 0;
  border: 0;
  background: transparent;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.4;
  text-align: left;
}

.item-card__source-quote {
  padding-left: var(--a-space-2);
  border-left: 1px solid var(--a-line);
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.item-card__suggestion {
  margin-top: var(--a-space-2);
  color: var(--a-ink);
  font-size: var(--a-type-action);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.item-card__summary-meta {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-1);
  margin-top: var(--a-space-2);
  color: var(--a-muted);
  font-size: var(--a-type-caption);
}

.item-card__field-line,
.item-card__ai-evidence {
  display: flex;
  align-items: flex-start;
  gap: var(--a-space-2);
  font-size: var(--a-type-meta);
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.item-card__field-name,
.item-card__ai-label {
  width: auto;
  flex: none;
  color: var(--a-muted);
  font-size: inherit;
}

.item-card__field-value {
  min-width: 0;
  flex: 1;
  color: var(--a-ink);
  font-size: inherit;
  line-height: inherit;
}

.item-card__ai-evidence {
  padding: var(--a-space-2) var(--a-space-2);
  border-left: 4rpx solid var(--a-accent-text);
  background: var(--a-ai-wash);
  color: var(--a-ink);
}

.item-card__ai-label {
  color: var(--a-accent-text);
  font-weight: var(--a-weight-medium);
}

/* 无依据的 AI 条目：用警示色描边而不是强调色填充，避免看起来像一条已确认的问题。 */
.item-card__unsupported {
  margin-top: var(--a-space-2);
  padding: var(--a-space-2);
  border: 1px solid var(--a-warning);
  border-radius: var(--a-radius-tight);
  color: var(--a-warning);
  font-size: var(--a-type-caption);
  line-height: 1.5;
}

.item-card__review-flag {
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  font-weight: var(--a-weight-regular);
  line-height: 1.5;
}

.item-card__action {
  display: flex;
  width: auto !important;
  min-height: var(--a-hit);
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 var(--a-space-2);
  border: 0;
  background: transparent;
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-size: var(--a-type-medium);
  font-weight: var(--a-weight-regular);
  line-height: 1.4;
}

.item-card__action::after {
  border: 0;
}

.item-card .item-card__more {
  align-self: flex-start;
  padding-left: 0;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
}

.item-card .item-card__delete {
  align-self: flex-end;
  padding-right: 0;
  color: var(--a-danger);
}

.item-card__image-scroll {
  width: 100%;
  white-space: nowrap;
}

.item-card__image-list {
  display: inline-flex;
  gap: var(--a-space-2);
}

.item-card__image-wrap {
  overflow: hidden;
  border: 0;
  border-radius: var(--a-radius-mark);
}

.item-card__image {
  width: 152rpx;
  height: 152rpx;
  background: var(--a-surface);
}
