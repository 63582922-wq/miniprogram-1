.item-card {
  background: #F2EDE4;
  border-radius: 0;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border: none;
  box-shadow: none;
}

.item-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-card__header-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-card__index {
  min-width: 34rpx;
  color: #6B6355;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 0;
}

.item-card__title {
  font-size: 26rpx;
  font-weight: 400;
  color: #1A1814;
  line-height: 1.2;
  letter-spacing: 0.04em;
}

.item-card__meta {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.item-card__badge {
  padding: 8rpx 18rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 400;
  border: 0.5px solid #B8A882;
}

.item-card__row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.item-card__field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.item-card__section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.item-card__section-title {
  font-size: 22rpx;
  font-weight: 400;
  color: #1A1814;
}

.item-card__label {
  font-size: 22rpx;
  color: #6B6355;
  font-weight: 400;
}

.item-card__input,
.item-card__textarea,
.item-card__picker {
  width: 100%;
  border-radius: 0;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid #E8E2D8;
  color: #1A1814;
  font-size: 22rpx;
}

.item-card__input,
.item-card__picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 0;
  box-sizing: border-box;
}

.item-card__picker {
  color: #1A1814;
}

.item-card__textarea {
  min-height: 120rpx;
  line-height: 1.6;
  padding: 18rpx 0;
  box-sizing: border-box;
}

.item-card__text {
  padding: 18rpx 0;
  border-radius: 0;
  background: transparent;
  border: none;
  color: #1A1814;
  font-size: 22rpx;
  line-height: 1.6;
}

.item-card__image-scroll {
  width: 100%;
  white-space: nowrap;
}

.item-card__image-list {
  display: inline-flex;
  gap: 12rpx;
}

.item-card__image-wrap {
  border-radius: 2rpx;
  overflow: hidden;
  border: none;
}

.item-card__image {
  width: 152rpx;
  height: 152rpx;
  background: #F2EDE4;
}
