/* Account and report identity share one continuous reading surface. */
.profile-page{display:flex;flex-direction:column;gap:0;padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}
.identity-card,.company-card{width:100%!important;margin:0!important;display:flex;align-items:center;gap:20rpx;padding:24rpx 0!important;background:transparent;border:0;border-bottom:1px solid var(--a-line);border-radius:0;text-align:left;color:var(--a-ink)}
.identity-card__copy,.company-card__copy{min-width:0;flex:1;overflow:hidden}.identity-status{font-size:26rpx;color:var(--a-muted);margin-bottom:4rpx}.profile-name{font-family:var(--a-font-body);font-size:36rpx;font-weight:600;letter-spacing:0;line-height:1.3;word-break:break-word}.profile-avatar{width:92rpx;height:92rpx;flex:none;border-radius:50%;background:transparent;border:1px solid var(--a-line)}.profile-avatar--empty{display:flex;align-items:center;justify-content:center;background:var(--a-surface);color:var(--a-ink);font-size:30rpx;font-weight:600}.profile-chevron{width:28rpx;height:28rpx;flex:none}
.profile-section-label{font-size:26rpx;color:var(--a-muted);letter-spacing:.08em;margin:28rpx 0 6rpx}.company-logo{width:88rpx;height:88rpx;flex:none;background:var(--a-field);border-radius:4rpx}.company-logo--empty{display:flex;align-items:center;justify-content:center;border:1px solid var(--a-line);color:var(--a-muted);font-size:26rpx;letter-spacing:.04em}.company-card .section-title{font-family:var(--a-font-body);font-size:32rpx;font-weight:600;word-break:break-word}.company-card__status{margin-top:10rpx;color:var(--a-muted);font-size:26rpx;line-height:1.4;word-break:break-word}
.profile-row{width:100%!important;margin:0!important;padding:0!important;display:flex;gap:20rpx;align-items:center;min-height:92rpx;border:0;border-bottom:1px solid var(--a-line);border-radius:0;font-size:30rpx;text-align:left;color:var(--a-ink)}.profile-row__chevron{width:28rpx;height:28rpx;margin-left:auto}.profile-note{font-size:26rpx;color:var(--a-muted);line-height:1.65;margin:18rpx 0 2rpx}
.profile-loading{padding-top:28rpx}.profile-loading__identity{display:flex;align-items:center;gap:24rpx;padding-bottom:32rpx;border-bottom:1px solid var(--a-line)}.profile-loading__avatar{width:104rpx;height:104rpx;flex:none;border-radius:50%;background:var(--a-surface)}.profile-loading__copy{flex:1;display:flex;flex-direction:column;gap:12rpx}.profile-loading__line,.profile-loading__row{background:linear-gradient(90deg,var(--a-surface) 0%,var(--a-field) 48%,var(--a-surface) 100%);background-size:220% 100%;animation:profileLoading 1.25s ease-in-out infinite}.profile-loading__line{height:20rpx;width:76%}.profile-loading__line--short{width:34%;height:14rpx}.profile-loading__line--medium{width:54%;height:14rpx}.profile-loading__label{margin:28rpx 0 12rpx;color:var(--a-muted);font-size:26rpx;letter-spacing:.08em}.profile-loading__row{height:96rpx;border-bottom:1px solid var(--a-line)}@keyframes profileLoading{0%{background-position:100% 0}100%{background-position:-100% 0}}
