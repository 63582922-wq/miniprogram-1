<view class="page profile-page">
  <page-nav-bar root="{{true}}" />
  <product-identity title="我的" />
  <view wx:if="{{loading}}" class="profile-loading" aria-label="正在确认身份与报告资料">
    <view class="profile-loading__identity"><view class="profile-loading__avatar"></view><view class="profile-loading__copy"><view class="profile-loading__line profile-loading__line--short"></view><view class="profile-loading__line"></view><view class="profile-loading__line profile-loading__line--medium"></view></view></view>
    <view class="profile-loading__label">正在确认身份与报告资料…</view>
    <view class="profile-loading__row"></view><view class="profile-loading__row"></view><view class="profile-loading__row"></view>
  </view>
  <view wx:elif="{{loadError}}" class="precision-state">{{loadError}}<button class="ui-button-reset secondary-button" bindtap="loadUser">重试加载</button></view>
  <block wx:else>
    <button class="ui-button-reset identity-card" bindtap="goSettings" data-section="inspector" hover-class="is-pressed">
      <image wx:if="{{displayUserInfo.avatarUrl}}" class="profile-avatar" src="{{displayUserInfo.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="profile-avatar profile-avatar--empty" aria-label="未设置头像"><image class="profile-avatar__placeholder-icon" src="/images/icons/icon-tab-profile.svg" mode="aspectFit" /></view>
      <view class="identity-card__copy"><view class="identity-status">账号已连接 · {{identity.hasInspector ? '巡查人资料已填写' : '巡查人资料待补充'}}</view><view class="profile-name">{{displayUserInfo.nickname || '填写巡查人姓名'}}</view><view class="section-subtitle">{{contactLine}}</view></view>
      <image class="profile-chevron" src="/images/icons/icon-arrow-right.svg" />
    </button>
    <view class="profile-section-label">报告抬头</view>
    <button class="ui-button-reset company-card" bindtap="goSettings" data-section="company" hover-class="is-pressed">
      <image wx:if="{{company.logoFileId && company.logoPreviewUrl}}" class="company-logo" src="{{company.logoPreviewUrl}}" mode="aspectFit" binderror="handleLogoPreviewError" />
      <view wx:else class="company-logo company-logo--empty">LOGO</view>
      <view class="company-card__copy"><view class="section-title">{{company.companyName || '填写公司名称'}}</view><view class="section-subtitle">{{company.companyPhone || '添加公司联系电话'}}</view><view wx:if="{{company.companyAddress}}" class="section-subtitle">{{company.companyAddress}}</view><view class="company-card__status">{{identity.completeCount}} / 4 已完善 · {{company.logoFileId ? (company.logoPreviewError ? 'LOGO 已上传 · 暂时无法预览' : 'LOGO 已上传') : '添加公司 LOGO'}}</view></view>
      <image class="profile-chevron" src="/images/icons/icon-arrow-right.svg" />
    </button>
    <view wx:if="{{identity.completeCount < 4}}" class="profile-note">{{completionText}}</view>
    <view class="profile-section-label">使用与设置</view>
    <button class="ui-button-reset profile-row" bindtap="openGuide"><text>使用说明</text><image class="profile-row__chevron" src="/images/icons/icon-arrow-right.svg" /></button>
    <button class="ui-button-reset profile-row" bindtap="openLegal"><text>隐私与服务说明</text><image class="profile-row__chevron" src="/images/icons/icon-arrow-right.svg" /></button>
    <view wx:if="{{buildText}}" class="profile-note profile-build">{{buildText}}</view>
  </block>
</view>
