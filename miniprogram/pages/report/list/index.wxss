.report-list-page{display:flex;flex-direction:column;gap:0;padding-bottom:calc(200rpx + env(safe-area-inset-bottom))}
.report-list-page .list{padding-top:0}.report-row{width:100%!important;margin:0!important;padding:28rpx 0!important;box-sizing:border-box;text-align:left;line-height:normal;color:inherit;border:0;border-bottom:1px solid var(--a-line);border-radius:0;background:transparent}
.report-row::after{border:0}.report-row__title{font-family:var(--a-font-body);font-size:34rpx;font-weight:600;letter-spacing:0;line-height:1.4;color:var(--a-ink);word-break:break-word}.report-row__desc{margin-top:6rpx;font-size:26rpx;color:var(--a-muted);font-variant-numeric:tabular-nums}.report-row__foot{display:flex;justify-content:space-between;align-items:center;font-size:26rpx;color:var(--a-muted);margin-top:16rpx}.report-row__foot image{width:28rpx;height:28rpx}
.report-filter{width:100%!important;margin:0!important;min-height:48px;padding:18rpx 0!important;display:flex;justify-content:space-between;align-items:center;gap:20rpx;font-size:27rpx;text-align:left;border:0;border-bottom:1px solid var(--a-line);border-radius:0;color:var(--a-ink)}.report-filter>view{display:flex;align-items:center;gap:8rpx;color:var(--a-muted);font-size:26rpx;white-space:nowrap}.report-filter image{width:28rpx;height:28rpx}
.filter-mask{position:fixed;inset:0;background:rgba(25,24,22,.45);z-index:60}.filter-sheet{position:fixed;bottom:0;left:0;right:0;padding:32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));background:var(--a-paper);z-index:61;border-radius:20rpx 20rpx 0 0}.filter-options{max-height:55vh;margin:24rpx 0}.filter-options button{width:100%!important;margin:0!important;min-height:48px;text-align:left;padding:24rpx 0!important;border-bottom:1px solid var(--a-line);font-size:30rpx}
