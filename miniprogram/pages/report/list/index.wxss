.report-row::after{border:0}.report-row__title{min-width:0}.report-row__meta{display:flex;align-items:center;gap:var(--a-space-1);margin-top:var(--a-space-1);color:var(--a-muted);font-size:var(--a-type-caption);line-height:1.4;font-variant-numeric:tabular-nums;letter-spacing:.02em}.report-row__separator{color:var(--a-line-strong)}.report-row__foot{display:flex;justify-content:space-between;align-items:center;gap:var(--a-space-2);font-size:var(--a-type-caption);color:var(--a-muted);margin-top:var(--a-space-1)}.report-row__metrics,.report-row__status{display:flex;align-items:center;gap:var(--a-space-1);min-width:0}.report-row__metrics{font-variant-numeric:tabular-nums}.report-row__status{margin-left:auto;white-space:nowrap}.report-row__icon{width:28rpx;height:28rpx;flex:none}
.report-filter{width:100%!important;margin:0!important;min-height:var(--a-hit-compact);padding:var(--a-space-2) 0!important;display:flex;justify-content:space-between;align-items:center;gap:var(--a-space-2);font-size:var(--a-type-meta);text-align:left;border:0;border-radius:0;color:var(--a-ink)}.report-filter__aside{display:flex;align-items:center;gap:var(--a-space-1);color:var(--a-muted);font-size:var(--a-type-caption);white-space:nowrap}.report-filter__icon{width:28rpx;height:28rpx}
