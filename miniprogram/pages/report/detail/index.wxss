.report-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 180rpx;
}

/* ===== 封面区 ===== */
.report-cover {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.report-cover__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

/* 报告编号用等宽字体：它是被引用、被对账的标识，需要逐字符可辨 */
.report-cover__no {
  font-size: 20rpx;
  color: #6B6355;
  letter-spacing: 0.1em;
  font-family: "SF Mono", "Menlo", monospace;
}

.report-cover__logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 2rpx;
  flex-shrink: 0;
}

.report-cover__title {
  font-size: 40rpx;
  color: #1A1814;
  line-height: 1.3;
}

.report-cover__meta {
  font-size: 24rpx;
  color: #6B6355;
}

.report-cover__company {
  font-size: 24rpx;
  color: #1A1814;
}

/* ===== 摘要卡 ===== */
.report-summary {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report-summary__kpis {
  display: flex;
  justify-content: space-between;
}

.kpi {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.kpi__n {
  font-size: 52rpx;
  line-height: 1;
  color: #1A1814;
  font-variant-numeric: tabular-nums;
}

/* 严重度只用颜色区分数字，不做彩色背景块 */
.kpi__n--critical { color: #B3402E; }
.kpi__n--major { color: #B8862B; }
.kpi__n--normal { color: #5C7A5C; }

.kpi__l {
  font-size: 22rpx;
  color: #6B6355;
}

.report-summary__bar {
  display: flex;
  height: 6rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #E8E2D8;
}

.bar__seg {
  height: 100%;
}

.bar__seg--critical { background: #B3402E; }
.bar__seg--major { background: #B8862B; }
.bar__seg--normal { background: #5C7A5C; }

.report-summary__conclusion {
  font-size: 26rpx;
  color: #1A1814;
  line-height: 1.6;
}

/* ===== 问题清单 ===== */
.report-issues {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-issues__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
}

.report-issues__count {
  font-size: 22rpx;
  color: #6B6355;
}

.issue-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.issue-group__head {
  font-size: 30rpx;
  color: #1A1814;
  letter-spacing: 0.06em;
}

.issue-group__media {
  width: 100%;
  overflow: hidden;
}

.issue-group__image {
  width: 100%;
  display: block;
}

.issue {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 16rpx;
  border-top: 0.5px solid #E8E2D8;
}

.issue__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.issue__no {
  font-size: 24rpx;
  color: #1A1814;
  font-family: "SF Mono", "Menlo", monospace;
  letter-spacing: 0.04em;
}

.issue__severity {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.issue__severity--critical {
  color: #B3402E;
  background: rgba(179, 64, 46, 0.08);
}

.issue__severity--major {
  color: #B8862B;
  background: rgba(184, 134, 43, 0.1);
}

.issue__severity--normal {
  color: #5C7A5C;
  background: rgba(92, 122, 92, 0.1);
}

.issue__area {
  font-size: 22rpx;
  color: #6B6355;
}

.issue__desc {
  font-size: 26rpx;
  color: #1A1814;
  line-height: 1.65;
}

.issue__suggestion {
  font-size: 24rpx;
  color: #6B6355;
  line-height: 1.6;
}

.issue__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 20rpx;
  color: #94908A;
}

/* ===== 结尾区 ===== */
.report-footer {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.report-footer__row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.report-footer__label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #94908A;
}

.report-footer__value {
  flex: 1;
  font-size: 24rpx;
  color: #1A1814;
  line-height: 1.55;
  word-break: break-all;
}

.report-footer__value--link {
  color: #B3402E;
}

/* ===== 状态态 ===== */
.report-state {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.report-action-button {
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0 44rpx;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 400;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.report-action-button--primary {
  background: #1A1814;
  color: #D4C5A0;
  box-shadow: none;
  letter-spacing: 0.2em;
}

.report-action-button--secondary {
  width: 100%;
  background: transparent;
  color: #6B6355;
  border: 0.5px solid #B8A882;
  font-size: 24rpx;
  font-weight: 400;
  height: 84rpx;
  padding: 0 24rpx;
  box-shadow: none;
  letter-spacing: 0.1em;
}

.report-action-button--disabled {
  opacity: 0.72;
}

.report-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.report-action-row .report-action-button {
  width: 100%;
  min-width: 0;
}

.report-action-button--share::after {
  border: none;
}

.report-action-button--share {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}


/* 分享进来的只读视图提示 */
.report-readonly-hint {
  font-size: 22rpx;
  color: #6B6355;
  text-align: center;
  line-height: 1.5;
  padding: 8rpx 0;
}
