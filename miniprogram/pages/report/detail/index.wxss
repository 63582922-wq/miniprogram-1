.report-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 180rpx;
}

.report-hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.report-hero__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.report-hero__logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 2rpx;
  background: #F2EDE4;
  border: none;
  flex-shrink: 0;
}

.report-hero__meta {
  font-size: 20rpx;
  color: #6B6355;
  font-weight: 400;
}

.report-company {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.report-state {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-text {
  font-size: 24rpx;
  color: #6B6355;
  line-height: 1.7;
}

.report-action-button {
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0 44rpx;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 400;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.report-action-button--primary {
  background: #1A1814;
  color: #D4C5A0;
  box-shadow: none;
  letter-spacing: 0.2em;
}

.report-action-button--secondary {
  width: 100%;
  background: transparent;
  color: #6B6355;
  border: 0.5px solid #B8A882;
  font-size: 24rpx;
  font-weight: 400;
  height: 84rpx;
  padding: 0 24rpx;
  box-shadow: none;
  letter-spacing: 0.1em;
}

.report-action-button--disabled {
  opacity: 0.72;
}

.report-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.report-action-row .report-action-button {
  width: 100%;
  min-width: 0;
}

.report-action-button--share::after {
  border: none;
}

.report-action-button--share {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}

.coach-tip {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 90;
  background: #1A1814;
  color: #FAF9F7;
  border-radius: 0;
  padding: 18rpx 20rpx;
}

.coach-tip__title {
  font-size: 26rpx;
  font-weight: 400;
}

.coach-tip__arrow {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B8A882;
}

.coach-tip__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.coach-tip__actions {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
}

.coach-tip__btn {
  flex: 1;
  height: 64rpx;
  border-radius: 0;
  background: #1A1814;
  color: #FAF9F7;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coach-tip__btn--ghost {
  background: transparent;
  border: 0.5px solid #B8A882;
  color: #6B6355;
}

.coach-highlight {
  position: relative;
  z-index: 120;
  box-shadow: 0 0 0 6rpx rgba(184, 168, 130, 0.35), 0 0 0 12rpx rgba(184, 168, 130, 0.2);
}
