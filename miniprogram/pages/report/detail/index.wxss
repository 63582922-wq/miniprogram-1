.report-page {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
}

.report-state {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.report-cover {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 0;
  padding: 32rpx 0 28rpx;
  background: transparent;
  color: var(--a-ink);
  border-bottom: 1px solid var(--a-line);
}

.report-cover__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
}

.report-cover__product-kind,
.report-cover__issuer-label,
.report-cover__readonly {
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  letter-spacing: .08em;
  line-height: 1.45;
}

.report-cover__no {
  color: var(--a-muted);
  font-family: var(--a-font-body);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: .08em;
}

.report-cover__title {
  color: var(--a-ink);
  font-family: var(--a-font-display);
  font-size: 52rpx;
  font-weight: 500;
  letter-spacing: -.4rpx;
  line-height: 1.2;
  word-break: break-word;
}

.report-cover__title--ui {
  font-family: var(--a-font-body);
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -.4rpx;
}

.report-cover__meta {
  color: var(--a-muted);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.55;
}

.report-cover__issuer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-top: 18rpx;
  border-top: 1px solid var(--a-line);
}

.report-cover__logo {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  border-radius: 4rpx;
}

.report-cover__issuer-copy {
  min-width: 0;
  flex: 1;
}

.report-cover__company {
  margin-top: 3rpx;
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.report-cover__issuer-person {
  margin-top: 6rpx;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.5;
  word-break: break-word;
}

.report-summary {
  padding: 24rpx 0;
  border-bottom: 1px solid var(--a-line);
}

.report-summary__conclusion {
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-size: var(--a-type-body);
  font-weight: 400;
  line-height: 1.55;
}

.report-issues {
  display: flex;
  flex-direction: column;
}

.report-issues__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0 16rpx;
}

.report-issues__count {
  flex: none;
  color: var(--a-muted);
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}

.issue-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 0;
  border-top: 2px solid var(--a-ink);
}

.issue-group__head {
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.issue-group__media {
  width: 100%;
  overflow: hidden;
  background: var(--a-surface);
}

.issue-group__image {
  width: 100%;
  display: block;
}

.issue {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 16rpx;
  border-top: 1px solid var(--a-line);
}

.issue__head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}

.issue__no,
.issue__severity,
.issue__area,
.issue__meta {
  font-size: 26rpx;
}

.issue__no {
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-weight: 600;
  letter-spacing: .02em;
}

.issue__severity {
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.issue__severity--critical {
  color: var(--a-danger);
  background: #F2DDD8;
}

.issue__severity--major {
  color: var(--a-warning);
  background: #F1E5D4;
}

.issue__severity--normal {
  color: var(--a-ink);
  background: var(--a-surface);
}

.issue__area,
.issue__meta {
  color: var(--a-muted);
}

.issue__desc {
  color: var(--a-ink);
  font-size: var(--a-type-body);
  line-height: 1.7;
}

.issue__suggestion {
  color: var(--a-muted);
  font-size: var(--a-type-action);
  line-height: 1.65;
}

.issue__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  line-height: 1.5;
}

.report-footer {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 28rpx 0;
  border-top: 1px solid var(--a-line);
}

.report-footer__title {
  margin-bottom: 8rpx;
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
}

.report-footer__row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.report-footer__label {
  width: 140rpx;
  flex: none;
  color: var(--a-muted);
  font-size: 26rpx;
}

.report-footer__value {
  min-width: 0;
  flex: 1;
  color: var(--a-ink);
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-word;
}

.report-footer__value--link {
  color: var(--a-danger);
}

.report-footer__phone {
  min-height: 44px;
  margin: -12rpx 0 !important;
  padding: 12rpx 0 !important;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  background: transparent;
  border-radius: 0;
  text-align: left;
}

.report-footer__phone::after {
  border: 0;
}

.share-manage {
  width: auto !important;
  min-height: 44px;
  margin: 8rpx 0 0 !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  background: transparent;
  color: var(--a-active);
  font-size: 26rpx;
  text-decoration: underline;
  text-underline-offset: 7rpx;
}

.share-manage::after,
.report-action-button::after {
  border: 0;
}

.report-product-signature {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1px solid var(--a-line);
}

.report-product-signature__mark {
  width: 54rpx;
  height: 54rpx;
  flex: none;
}

.report-product-signature__name {
  font-family: var(--a-font-display);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.report-product-signature__desc {
  margin-top: 5rpx;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  letter-spacing: .04em;
  line-height: 1.4;
}

.report-page .footer-actions--fixed {
  gap: 8rpx;
}

.report-delivery-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  width: 100%;
}

.report-delivery-row > .report-action-button {
  min-width: 0;
  flex: 1;
}

.report-pdf-action {
  min-width: 0;
  flex: 0 0 220rpx;
}

.report-action-button {
  width: 100%;
  min-height: 48px;
  height: auto;
  margin: 0;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--a-radius-control);
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.3;
  text-align: center;
}

.report-action-button--primary {
  background: var(--a-accent);
  color: var(--a-accent-ink);
}

.report-action-button--secondary {
  background: transparent;
  color: var(--a-ink);
  border: 1px solid var(--a-line);
}

.report-pdf-action .report-action-button {
  padding-left: 10rpx;
  padding-right: 10rpx;
  font-size: var(--a-type-caption);
}

.report-action-button--disabled {
  opacity: .5;
}

.report-readonly-hint {
  padding: 2rpx 0;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.5;
  text-align: center;
}
