<view wx:if="{{loading}}" class="page report-page">
  <page-nav-bar title="巡查报告" showBack="{{true}}" autoBack="{{false}}" bind:backtap="handleBackTap" />
  <view class="card report-state">
    <view class="section-title">正在加载报告</view>
    <view class="section-subtitle">正在整理本次巡查报告数据，请稍等。</view>
  </view>
</view>

<view wx:elif="{{loadError}}" class="page report-page">
  <page-nav-bar title="巡查报告" showBack="{{true}}" autoBack="{{false}}" bind:backtap="handleBackTap" />
  <view class="card report-state">
    <view class="section-title">报告暂时无法打开</view>
    <view class="section-subtitle">{{loadError}}</view>
  </view>
</view>

<view class="page report-page" wx:elif="{{report}}">
  <page-nav-bar title="巡查报告" showBack="{{true}}" autoBack="{{false}}" bind:backtap="handleBackTap" />

  <!-- 封面区：这是什么报告、谁出的、什么时候 -->
  <view class="card report-cover">
    <view class="report-cover__top">
      <view class="report-cover__no">{{report.reportNo}}</view>
      <image wx:if="{{report.logoFileId}}" class="report-cover__logo" src="{{report.logoFileId}}" mode="aspectFit" />
    </view>
    <view class="report-cover__title">{{report.projectName || report.title}}</view>
    <view class="report-cover__meta">
      <text>{{report.inspectionDateDisplay}}</text>
      <text wx:if="{{report.inspectorName}}"> · 巡查人 {{report.inspectorName}}</text>
    </view>
    <view wx:if="{{report.companyName}}" class="report-cover__company">{{report.companyName}}</view>
  </view>

  <!-- 摘要卡：读者 3 秒内要拿到的答案 -->
  <view class="card report-summary">
    <view class="report-summary__kpis">
      <view class="kpi">
        <view class="kpi__n kpi__n--critical">{{report.severityStats.critical}}</view>
        <view class="kpi__l">严重</view>
      </view>
      <view class="kpi">
        <view class="kpi__n kpi__n--major">{{report.severityStats.major}}</view>
        <view class="kpi__l">较重</view>
      </view>
      <view class="kpi">
        <view class="kpi__n kpi__n--normal">{{report.severityStats.normal}}</view>
        <view class="kpi__l">一般</view>
      </view>
      <view class="kpi">
        <view class="kpi__n">{{report.severityStats.total}}</view>
        <view class="kpi__l">合计</view>
      </view>
    </view>
    <view class="report-summary__bar">
      <view class="bar__seg bar__seg--critical" style="width:{{report.severityStats.criticalPercent}}%"></view>
      <view class="bar__seg bar__seg--major" style="width:{{report.severityStats.majorPercent}}%"></view>
      <view class="bar__seg bar__seg--normal" style="width:{{report.severityStats.normalPercent}}%"></view>
    </view>
    <view class="report-summary__conclusion">{{report.conclusion}}</view>
  </view>

  <report-section wx:if="{{report.summary}}" title="巡查小结" content="{{report.summary}}" />

  <report-section wx:if="{{report.contextNote}}" title="现场补充" content="{{report.contextNote}}" />

  <!-- 问题清单：按照片分组，同图多问题只出现一次照片 -->
  <view class="report-issues">
    <view class="report-issues__head">
      <view class="section-title">问题清单</view>
      <view class="report-issues__count">{{report.severityStats.total}} 项</view>
    </view>

    <view wx:if="{{!report.issueGroups.length}}" class="card report-state">
      <view class="section-subtitle">本次巡查未记录问题项。</view>
    </view>

    <view wx:for="{{report.issueGroups}}" wx:for-item="group" wx:key="key" class="card issue-group">
      <view class="issue-group__head">{{group.groupTitle}}</view>

      <view wx:if="{{group.image}}" class="issue-group__media">
        <image
          class="issue-group__image"
          src="{{group.image}}"
          mode="widthFix"
          data-src="{{group.image}}"
          bindtap="handlePreviewImage"
        />
      </view>

      <view wx:for="{{group.issues}}" wx:for-item="issue" wx:key="displayNo" class="issue">
        <view class="issue__head">
          <text class="issue__no">{{issue.displayNo}}</text>
          <text class="issue__severity issue__severity--{{issue.severity}}">{{issue.severityText}}</text>
          <text wx:if="{{issue.area}}" class="issue__area">{{issue.area}}</text>
        </view>
        <view class="issue__desc">{{issue.description}}</view>
        <view wx:if="{{issue.suggestion}}" class="issue__suggestion">建议：{{issue.suggestion}}</view>
        <view class="issue__meta">
          <text wx:if="{{issue.responsibleText}}">责任方 {{issue.responsibleText}}</text>
          <text wx:if="{{issue.timeText}}">拍摄于 {{issue.timeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 结尾区：出具信息与状态 -->
  <view class="card report-footer">
    <view class="report-footer__row">
      <text class="report-footer__label">出具单位</text>
      <text class="report-footer__value">{{report.companyName || '未填写'}}</text>
    </view>
    <view wx:if="{{report.companyPhone}}" class="report-footer__row">
      <text class="report-footer__label">联系电话</text>
      <text class="report-footer__value report-footer__value--link" data-phone="{{report.companyPhone}}" bindtap="handleCallCompany">{{report.companyPhone}}</text>
    </view>
    <view wx:if="{{report.companyAddress}}" class="report-footer__row">
      <text class="report-footer__label">地址</text>
      <text class="report-footer__value">{{report.companyAddress}}</text>
    </view>
    <view class="report-footer__row">
      <text class="report-footer__label">报告编号</text>
      <text class="report-footer__value">{{report.reportNo}}</text>
    </view>
    <view class="report-footer__row">
      <text class="report-footer__label">出具时间</text>
      <text class="report-footer__value">{{report.generatedAtDisplay || '待生成'}}</text>
    </view>
  </view>

  <view class="footer-actions footer-actions--fixed">
    <!-- 主操作是「把报告发出去」：报告页本身就是交付物，
         PDF 只是可选归档，所以它降为次要操作 -->
    <button
      wx:if="{{isOwner}}"
      class="report-action-button report-action-button--primary report-action-button--share"
      open-type="share"
    >转发给业主 / 施工方</button>

    <view wx:if="{{isOwner}}" class="report-action-row">
      <view wx:if="{{report.isPdfGenerating}}" class="report-action-button report-action-button--secondary report-action-button--disabled">PDF 生成中</view>
      <view wx:elif="{{report.pdfFileId && !report.isPdfOutdated}}" class="report-action-button report-action-button--secondary" bindtap="openPdf">打开已生成 PDF</view>
      <view wx:elif="{{report.isPdfFailed}}" class="report-action-button report-action-button--secondary" bindtap="generatePdf">PDF 生成失败，重试</view>
      <view wx:else class="report-action-button report-action-button--secondary" bindtap="generatePdf">下载 PDF 归档</view>

      <view wx:if="{{report.pdfFileId && !report.isPdfOutdated}}" class="report-action-button report-action-button--secondary" bindtap="savePdfToLocal">保存到本地</view>
      <view wx:else class="report-action-button report-action-button--secondary" bindtap="handleHomeTap">返回首页</view>
    </view>

    <!-- PDF 只是可选归档。它失败不该影响阅读与转发，这里把话说明白 -->
    <view wx:if="{{isOwner && report.isPdfFailed}}" class="report-readonly-hint">
      报告内容已就绪，可直接转发阅读。PDF 是归档用的额外产物，失败不影响上面的内容。
    </view>

    <view wx:if="{{!isOwner}}" class="report-readonly-hint">
      你正在查看他人分享的巡查报告，内容为只读。
    </view>
  </view>
</view>

<view wx:else class="page report-page">
  <page-nav-bar title="巡查报告" showBack="{{true}}" autoBack="{{false}}" bind:backtap="handleBackTap" />
  <view class="card report-state">
    <view class="section-title">暂无报告数据</view>
    <view class="section-subtitle">请先确认巡查问题，再生成报告。</view>
  </view>
</view>
