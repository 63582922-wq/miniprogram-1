<view class="page chat-page">
  <page-nav-bar title="聊天整理" showBack="{{true}}" />

  <view class="card">
    <view class="section-subtitle">请将微信聊天内容复制后粘贴到下方文本框，再交给 AI 做整理。</view>
    <view class="field-label">聊天内容</view>
    <textarea class="field-textarea" value="{{sourceText}}" bindinput="handleInput" placeholder="粘贴客户、供应商、施工方的聊天记录" />
  </view>

  <view class="footer-actions">
    <button class="primary-button" bindtap="handleAnalyze">开始聊天整理</button>
  </view>

  <view wx:if="{{result}}" class="list">
    <view class="card">
      <view class="section-title">整理摘要</view>
      <view class="detail-text">{{result.analysisSummary}}</view>
    </view>
    <view class="card">
      <view class="section-title">需求提取</view>
      <view wx:for="{{result.requirements}}" wx:key="index" class="detail-row">{{item}}</view>
    </view>
    <view class="card">
      <view class="section-title">报价汇总</view>
      <view wx:for="{{result.quotations}}" wx:key="index" class="detail-row">{{item.vendor}}：{{item.price}}（{{item.note}}）</view>
    </view>
  </view>
</view>
