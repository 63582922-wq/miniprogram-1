.settings-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 48rpx;
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-static {
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  border-radius: 0;
  background: transparent;
  color: #1A1814;
  font-size: 28rpx;
  font-weight: 400;
  border-bottom: 0.5px solid #E8E2D8;
}

.link-row {
  min-height: 88rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 0.5px solid #E8E2D8;
}

.link-row:last-child {
  border-bottom: none;
}

.link-row__text {
  color: #1A1814;
  font-size: 28rpx;
}

.link-row__arrow {
  color: #B8A882;
  font-size: 28rpx;
}

.edit-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(26, 24, 20, 0.28);
  z-index: 100;
}

.edit-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  max-width: 560rpx;
  padding: 40rpx 36rpx;
  border-radius: 4rpx;
  background: #F2EDE4;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 110;
}

.edit-modal__actions {
  display: flex;
  gap: 10rpx;
  margin-top: 8rpx;
}

.edit-modal__btn {
  flex: 1;
  height: 72rpx;
  border-radius: 0;
  background: #1A1814;
  color: #D4C5A0;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.1em;
}

.edit-modal__btn--ghost {
  background: transparent;
  border: 0.5px solid #B8A882;
  color: #6B6355;
}

.coach-tip {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: calc(env(safe-area-inset-top) + 110rpx);
  z-index: 99;
  background: #1A1814;
  color: #FAF9F7;
  border-radius: 0;
  padding: 18rpx 20rpx;
}

.coach-mask {
  position: fixed;
  inset: 0;
  z-index: 96;
  background: rgba(26, 24, 20, 0.28);
  pointer-events: none;
}

.coach-target-hint {
  position: fixed;
  right: 34rpx;
  bottom: calc(env(safe-area-inset-bottom) + 150rpx);
  z-index: 121;
  padding: 10rpx 14rpx;
  border-radius: 0;
  background: #B8A882;
  color: #FAF9F7;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  animation: coachHintPulse 1.4s ease-in-out infinite;
}

.coach-target-hint__arrow {
  font-size: 26rpx;
}

.coach-tip__title {
  font-size: 26rpx;
  font-weight: 400;
}

.coach-tip__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.coach-tip__btn {
  margin-top: 14rpx;
  height: 64rpx;
  border-radius: 0;
  background: #1A1814;
  color: #FAF9F7;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coach-tip__btn--ghost {
  background: transparent;
  border: 0.5px solid #B8A882;
  color: #6B6355;
}

.coach-highlight {
  position: relative;
  z-index: 120;
  box-shadow: 0 0 0 6rpx rgba(184, 168, 130, 0.35), 0 0 0 12rpx rgba(184, 168, 130, 0.2);
  animation: coachTargetPulse 1.4s ease-in-out infinite;
}

@keyframes coachTargetPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

@keyframes coachHintPulse {
  0%, 100% {
    opacity: 0.88;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-2rpx);
  }
}
