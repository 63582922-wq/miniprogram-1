.settings-page{display:flex;flex-direction:column;gap:0;padding-bottom:calc(var(--a-space-5) + env(safe-area-inset-bottom))}
.settings-intro{padding:var(--a-space-3) 0 var(--a-space-2);font-size:var(--a-type-caption);line-height:1.65;color:var(--a-muted)}
.settings-section{padding:var(--a-space-3) 0;scroll-margin-top:var(--a-space-15)}
.settings-section>.section-title{margin-bottom:var(--a-space-3)}
.settings-page .footer-actions{margin-top:var(--a-space-2)}
.settings-page .field-textarea{min-height:100rpx}
