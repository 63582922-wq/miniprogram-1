.memo-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 180rpx;
}

.memo-header {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.memo-header__count {
  width: 172rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #B8A882;
}

.memo-create-button {
  width: auto;
  min-width: 240rpx;
  height: 84rpx;
  margin: 0 auto;
  padding: 0 44rpx;
  border-radius: 0;
  background: #1A1814;
  color: #D4C5A0;
  font-size: 24rpx;
  font-weight: 400;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  letter-spacing: 0.2em;
}

.memo-row {
  padding: 20rpx;
  border-radius: 2rpx;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid #E8E2D8;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.memo-row__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.memo-row__title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.45;
  color: #1A1814;
}

.memo-row__status {
  width: 172rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #B8A882;
}

.memo-row__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.memo-row__badge {
  padding: 7rpx 16rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 400;
  border: 0.5px solid #B8A882;
}

.memo-row__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.memo-row__action {
  min-width: 96rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #B8A882;
}

.memo-row__action--primary {
  background: #1A1814;
  color: #D4C5A0;
  border-color: #1A1814;
}
