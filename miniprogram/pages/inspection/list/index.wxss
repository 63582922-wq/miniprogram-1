.inspection-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.inspection-row {
  background: #F2EDE4;
  border-radius: 4rpx;
  padding: 20rpx;
  border: none;
  box-shadow: none;
}

.inspection-row__title {
  font-size: 28rpx;
  font-weight: 400;
  color: #1A1814;
}

.inspection-row__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6B6355;
}
