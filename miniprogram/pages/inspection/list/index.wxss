.inspection-page {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.inspection-row{width:100%;box-sizing:border-box;padding:var(--a-space-3) 0;margin:0;border:0;background:transparent;border-radius:0;box-shadow:none;text-align:left;line-height:normal;color:inherit}
.inspection-row::after{border:0}

.inspection-row__title {
  font-size:var(--a-type-body);
  font-weight:var(--a-weight-emphasis);
  color: var(--a-ink);
}

.inspection-row__desc {
  margin-top: var(--a-space-1);
  font-size:var(--a-type-caption);
  color: var(--a-muted);
}
