.inspection-result-page {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-bottom: calc(var(--a-space-review-clearance) + env(safe-area-inset-bottom));
}

.review-change-notice {
  padding: var(--a-space-2) 0;

  color: var(--a-active);
  font-size: var(--a-type-caption);
  line-height: 1.5;
}

.ai-review-notice{display:flex;flex-direction:column;gap:var(--a-space-1);margin:var(--a-space-2) 0;padding:var(--a-space-2) 0;color:var(--a-ink);font-size:var(--a-type-caption);line-height:1.55}
.ai-review-notice__title{font-size:var(--a-type-medium);font-weight:var(--a-weight-emphasis);color:var(--a-accent-text)}
.ai-review-notice__counts{display:flex;flex-wrap:wrap;gap:var(--a-space-3);color:var(--a-ink);font-size:var(--a-type-body);font-weight:var(--a-weight-medium)}
.ai-review-notice--empty{background:transparent;}
.ai-review-notice--empty .ai-review-notice__title{color:var(--a-ink)}
.ai-observation-empty{display:flex;flex-direction:column;gap:var(--a-space-1);padding:var(--a-space-3);border-radius:var(--a-radius-control);background:var(--a-surface);color:var(--a-muted);font-size:var(--a-type-caption);line-height:1.55}
.ai-observation-empty__title{color:var(--a-ink);font-size:var(--a-type-body);font-weight:var(--a-weight-medium)}
.ai-review-retry{align-self:flex-start;min-height:var(--a-hit-compact);margin:var(--a-space-1) 0 0;padding:0;color:var(--a-accent-text);font-size:var(--a-type-body);font-weight:var(--a-weight-emphasis);line-height:var(--a-hit-compact);background:transparent;border:0;text-align:left}
.ai-review-retry::after{border:0}
.ai-observation{margin:var(--a-space-2) 0;padding:var(--a-space-2) 0;}
.review-submit{min-height:var(--a-hit-review);font-size:var(--a-type-action)!important;font-weight:var(--a-weight-emphasis)!important}

.review-identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--a-space-2);
  padding: var(--a-space-3) 0;

  font-size: var(--a-type-action);
}

.review-identity__logo {
  width: var(--a-logo-company);
  height: var(--a-logo-company);
  flex: none;
  background: var(--a-field);
  border-radius: var(--a-radius-tight);
}

.review-identity__logo-error {
  max-width: 80rpx;
  flex: none;
  color: var(--a-muted);
  font-size:var(--a-type-caption);
  line-height: 1.4;
}

.review-identity__retry {
  display: inline-flex;
  min-height: var(--a-hit);
  align-items: center;
  margin: var(--a-space-1) var(--a-space-2) 0 0 !important;
  padding: 0 var(--a-space-2) !important;
  border: 0;
  color: var(--a-active);
  font-size:var(--a-type-caption);
}

.review-identity__copy {
  min-width: 0;
  flex: 1;
}

.review-identity__company {
  margin-top: var(--a-space-1);
  font-family: var(--a-font-body);
  font-size:var(--a-type-action);
  font-weight:var(--a-weight-regular);
  line-height: 1.5;
  word-break: break-word;
}

.review-identity__edit {
  width: auto !important;
  min-height: var(--a-hit);
  margin: 0 !important;
  padding: 0 var(--a-space-1) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 0;
  color: var(--a-active);
  font-size:var(--a-type-caption);
  font-weight:var(--a-weight-regular);
}

.result-guide {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
  padding: var(--a-space-3) 0;

}

.legacy-photo-note{display:flex;flex-direction:column;gap:var(--a-space-1);padding:var(--a-space-2) 0;color:var(--a-muted)}
.legacy-photo-note__label{font-size:var(--a-type-caption);line-height:1.4}

.result-memory {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-1);
  padding: var(--a-space-3) 0;

}

.result-memory__label {
  color: var(--a-muted);
  font-size:var(--a-type-caption);
  line-height: 1.4;
  letter-spacing: .08em;
}.result-memory__item{
  color: var(--a-muted);
  font-size:var(--a-type-caption);
  line-height: 1.7;
}

.result-memory__list {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-1);
}

.result-memory__item {
  position: relative;
  padding-left: var(--a-space-3);
}

.result-memory__item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--a-line);
}

.detail-text {
  font-size: var(--a-type-body);
  line-height: 1.7;
}

.list {
  padding-bottom: var(--a-space-2);
}

.result-group {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
  padding: var(--a-space-4) 0;

}

.result-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--a-space-2);
}

.result-group__title {
  min-width: 0;
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-size:var(--a-type-section);
  font-weight:var(--a-weight-medium);
  line-height: 1.35;
  word-break: break-word;
}

.result-group__count {
  flex: none;
  padding: 0;
  background: transparent;
  color: var(--a-muted);
  border: 0;
  font-size:var(--a-type-caption);
}

.result-group__media {
  overflow: hidden;
  background: var(--a-surface);
}

.result-group__image {
  width: 100%;
  height: auto;
  display: block;
}

.result-group__issues {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
}

.result-add-issue {
  width: auto !important;
  min-height: var(--a-hit);
  margin: 0 !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  background: transparent;
  color: var(--a-active);
  font-size:var(--a-type-medium);
  font-weight:var(--a-weight-regular);
  line-height: 1.4;
  text-decoration: none;
}

.result-photo-actions{display:flex;align-items:center;justify-content:space-between}
.result-caption{margin-bottom:0}

.issue-entry {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-1);
}

.issue-entry + .issue-entry {
  margin-top: 0;
  padding-top: 0;
  border: 0;
}
.review-context{padding:var(--a-space-3) 0 var(--a-space-2);display:flex;flex-direction:column;gap:var(--a-space-1);font-size:var(--a-type-body)}
.review-context__count{font-size:var(--a-type-caption);color:var(--a-muted)}
