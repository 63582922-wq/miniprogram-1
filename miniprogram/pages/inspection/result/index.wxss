.inspection-result-page {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.review-identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--a-line);
  font-size: var(--a-type-action);
}

.review-identity__logo {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  background: var(--a-field);
  border-radius: 4rpx;
}

.review-identity__copy {
  min-width: 0;
  flex: 1;
}

.review-identity__company {
  margin-top: 4rpx;
  font-family: var(--a-font-body);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.review-identity__freeze {
  margin-top: 10rpx;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.5;
}

.review-identity__edit {
  width: auto !important;
  min-height: 44px;
  margin: 0 !important;
  padding: 16rpx !important;
  flex: none;
  border: 1px solid var(--a-line);
  color: var(--a-active);
  font-size: 26rpx;
}

.result-guide {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--a-line);
}

.result-guide__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.result-guide__content {
  color: var(--a-ink);
  font-size: var(--a-type-body);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.result-edit-link {
  width: auto !important;
  min-height: 44px;
  margin: 0 !important;
  padding: 8rpx 0 8rpx 20rpx !important;
  flex: none;
  background: transparent;
  color: var(--a-active);
  font-size: 26rpx;
}

.result-edit-link::after {
  border: 0;
}

.result-caption {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.result-caption__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.result-memory {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--a-line);
}

.result-memory__label {
  color: var(--a-muted);
  font-size: 26rpx;
  line-height: 1.4;
  letter-spacing: .08em;
}

.result-memory__text,
.result-memory__item {
  color: var(--a-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.result-memory__list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.result-memory__item {
  position: relative;
  padding-left: 22rpx;
}

.result-memory__item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--a-line);
}

.detail-text {
  font-size: var(--a-type-body);
  line-height: 1.7;
}

.result-list-heading {
  padding: 24rpx 0 16rpx;
  border-bottom: 1px solid var(--a-line);
}

.list {
  padding-bottom: 12rpx;
}

.result-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1px solid var(--a-line);
}

.result-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.result-group__title {
  min-width: 0;
  color: var(--a-ink);
  font-family: var(--a-font-body);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.result-group__count {
  flex: none;
  padding: 0;
  background: transparent;
  color: var(--a-muted);
  border: 0;
  font-size: 26rpx;
}

.result-group__media {
  overflow: hidden;
  background: var(--a-surface);
}

.result-group__image {
  width: 100%;
  height: 420rpx;
  display: block;
}

.result-group__issues {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.result-add-issue {
  width: auto !important;
  min-height: 44px;
  margin: 0 !important;
  padding: 0 !important;
  align-self: flex-start;
  background: transparent;
  color: var(--a-active);
  font-size: 28rpx;
  text-decoration: underline;
  text-underline-offset: 7rpx;
}

.issue-entry {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.issue-entry + .issue-entry {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid var(--a-line);
}

.issue-entry__delete {
  width: auto !important;
  min-height: 44px;
  margin: 0 !important;
  padding: 8rpx 0 !important;
  display: flex;
  align-items: center;
  align-self: flex-end;
  color: var(--a-danger);
  font-size: 26rpx;
}

.issue-entry__delete::after {
  border: 0;
}

.issue-entry__delete:active {
  opacity: .58;
}
