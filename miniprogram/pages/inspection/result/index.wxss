.inspection-result-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 260rpx;
}

.result-hero {
  gap: 14rpx;
  background: #F2EDE4;
  color: #1A1814;
}

.result-hero__eyebrow {
  font-size: 20rpx;
  color: #6B6355;
  font-weight: 400;
}

.result-hero__title {
  font-size: 30rpx;
  font-weight: 400;
  color: #1A1814;
  letter-spacing: 0.04em;
}

.result-hero__meta {
  font-size: 20rpx;
  color: #6B6355;
  font-weight: 400;
}

.result-hero__stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.result-hero__stat {
  min-height: 92rpx;
  border-radius: 2rpx;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid #E8E2D8;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6rpx;
}

.result-hero__stat-value {
  font-size: 26rpx;
  color: #1A1814;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

.result-hero__stat-label {
  font-size: 18rpx;
  color: #6B6355;
  font-weight: 400;
}

.result-guide {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.result-memory {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: transparent;
  border: none;
  border-bottom: 0.5px solid #E8E2D8;
}

.result-memory__label {
  font-size: 20rpx;
  line-height: 1.4;
  color: #6B6355;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.result-memory__text {
  font-size: 22rpx;
  line-height: 1.7;
  color: #6B6355;
}

.result-memory__list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.result-memory__item {
  position: relative;
  padding-left: 22rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: #6B6355;
}

.result-memory__item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #B8A882;
}

.result-guide__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-guide__icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.result-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.result-group__title {
  font-size: 26rpx;
  font-weight: 400;
  color: #1A1814;
  letter-spacing: 0.04em;
}

.result-group__count {
  padding: 8rpx 18rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 400;
  border: 0.5px solid #B8A882;
}

.result-group__media {
  border-radius: 2rpx;
  overflow: hidden;
  background: #F2EDE4;
}

.result-group__image {
  width: 100%;
  height: 340rpx;
  display: block;
}

.result-group__issues {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.list {
  padding-bottom: 12rpx;
}

/* 每条问题带一个删除入口：AI 误报必须能去掉 */
.issue-entry {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.issue-entry + .issue-entry {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 0.5px solid #E8E2D8;
}

.issue-entry__delete {
  align-self: flex-end;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #B3402E;
  letter-spacing: 0.04em;
}

.issue-entry__delete:active {
  opacity: 0.6;
}


/* 底部快速路径的说明文字 */
.result-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6B6355;
  text-align: center;
  line-height: 1.5;
}
