<view class="page inspection-result-page">
  <page-nav-bar title="巡查结果" showBack="{{true}}" autoBack="{{false}}" bind:backtap="handleBackTap" />
  <view class="card result-hero">
    <view class="result-hero__eyebrow">项目</view>
    <view class="result-hero__title">{{summary.projectName}}</view>
    <view class="result-hero__meta">{{summary.title}}</view>
    <view class="result-hero__stats">
      <view class="result-hero__stat">
        <view class="result-hero__stat-value">{{summary.issueCount}}</view>
        <view class="result-hero__stat-label">问题</view>
      </view>
      <view class="result-hero__stat">
        <view class="result-hero__stat-value">{{summary.contextNote ? '已补充' : '未补充'}}</view>
        <view class="result-hero__stat-label">现场补充</view>
      </view>
    </view>
  </view>

  <view class="card result-guide">
    <view class="result-guide__head">
      <image class="result-guide__icon" src="/images/icons/icon-project.svg" mode="aspectFit" />
      <view class="section-title">AI 巡查小结</view>
    </view>
    <view class="detail-text">{{summary.aiSummary || 'AI 正在根据问题生成本次巡查小结。'}}</view>
  </view>

  <view wx:if="{{summary.memoryHint}}" class="card result-memory">
    <view class="result-memory__label">AI 记忆</view>
    <view class="result-memory__text">{{summary.memoryHint}}</view>
    <view wx:if="{{summary.memoryAlerts && summary.memoryAlerts.length}}" class="result-memory__list">
      <view wx:for="{{summary.memoryAlerts}}" wx:key="*this" class="result-memory__item">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{summary.contextNote}}" class="card result-guide">
    <view class="result-guide__head">
      <image class="result-guide__icon" src="/images/icons/icon-note.svg" mode="aspectFit" />
      <view class="section-title">现场补充</view>
    </view>
    <view class="detail-text">{{summary.contextNote}}</view>
  </view>

  <view class="card result-guide">
    <view class="result-guide__head">
      <image class="result-guide__icon" src="/images/icons/icon-issue.svg" mode="aspectFit" />
      <view class="section-title">问题清单</view>
    </view>
  </view>

  <view class="list">
    <view wx:for="{{issueGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="key" class="result-group card">
      <view class="result-group__head">
        <view class="result-group__title">{{group.displayTitle}}</view>
        <view class="result-group__count">{{group.issues.length}} 条</view>
      </view>
      <view wx:if="{{group.image}}" class="result-group__media">
        <image class="result-group__image" src="{{group.image}}" mode="aspectFill" />
      </view>
      <view class="result-group__issues">
        <view
          wx:for="{{group.issues}}"
          wx:for-item="subIssue"
          wx:for-index="subIndex"
          wx:key="originalIndex"
          class="issue-entry"
        >
          <inspection-item-card
            item="{{subIssue}}"
            index="{{subIssue.originalIndex}}"
            displayIndex="{{subIssue.subIssueIndex || (subIndex + 1)}}"
            hideTitle="{{true}}"
            showImages="{{false}}"
            editable="{{true}}"
            bindchange="handleItemChange"
          />
          <view
            class="issue-entry__delete"
            data-index="{{subIssue.originalIndex}}"
            bindtap="handleDeleteIssue"
          >删除这条</view>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-actions footer-actions--fixed">
    <!-- 快速路径：AI 整理结果多数是对的，不必逐条点选。
         逐条核对仍然可用 —— 上面的清单就是为需要修正的情况准备的。 -->
    <button class="primary-button" bindtap="handleAcceptAllAndSubmit">全部通过并提交（{{summary.issueCount}} 条）</button>
    <view class="result-hint">若有识别不准的条目，可在上方删除或直接修改后再提交。</view>
  </view>
</view>
