<view class="page inspection-detail-page">
  <page-nav-bar title="巡查详情" showBack="{{true}}" autoBack="{{false}}" bind:backtap="handleBackTap" />
  <view class="inspection-detail__head">
    <view class="section-title">{{inspection.title}}</view>
    <view class="section-subtitle">{{inspection.projectNameText}}</view>
    <view class="section-subtitle">{{inspection.createdAtText}}</view>
    <view class="section-subtitle">{{items.length}} 条问题</view>
  </view>

  <view class="list">
    <inspection-item-card wx:for="{{items}}" wx:key="_id" item="{{item}}" index="{{index}}" />
  </view>

  <view class="footer-actions footer-actions--fixed">
    <button class="primary-button" bindtap="goReport">{{reportId ? '查看已生成报告' : '生成巡查报告'}}</button>
  </view>
</view>
