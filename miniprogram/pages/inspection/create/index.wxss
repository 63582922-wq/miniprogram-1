.inspection-create-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 180rpx;
}

.create-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.create-card--issues {
  gap: 0;
}

.create-card--project {
  gap: 16rpx;
}

.create-card--overview {
  gap: 16rpx;
  background: #F2EDE4;
  color: #1A1814;
}

.create-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.create-card__eyebrow {
  font-size: 20rpx;
  color: #6B6355;
  font-weight: 400;
}

.create-card__return {
  min-width: 132rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 20rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #B8A882;
}

.create-card__stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.create-card__stat {
  min-height: 94rpx;
  border-radius: 2rpx;
  background: transparent;
  border-bottom: 0.5px solid #E8E2D8;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6rpx;
}

.create-card__stat-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1814;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

.create-card__stat-label {
  font-size: 18rpx;
  color: #6B6355;
  font-weight: 400;
}

.create-card__section-title {
  font-size: 28rpx;
  line-height: 48rpx;
  color: #1A1814;
  font-weight: 400;
  display: flex;
  align-items: center;
}

.create-card__section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 56rpx;
}

.create-card__section-lead,
.create-card__field-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 48rpx;
}

.create-card__issue-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
}

.create-card__issue-bar .create-card__section-lead,
.create-card__issue-bar .create-card__issue-count {
  position: relative;
  z-index: 1;
}

.create-card__section-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.create-card__toggle,
.create-card__issue-count {
  width: 172rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #B8A882;
  line-height: 48rpx;
}

.create-card__supplement-fields {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.create-card--empty {
  align-items: center;
  text-align: center;
  gap: 12rpx;
  padding: 48rpx 36rpx;
}

.create-card__empty-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #1A1814;
}

.issue-draft-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.issue-draft-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.issue-draft-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.issue-draft-card__header-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  max-width: 220rpx;
}

.issue-draft-card__title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.issue-draft-card__title-main {
  flex: 1;
  min-width: 0;
}

.issue-draft-card__index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 2rpx;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 0.5px solid #B8A882;
}

.issue-draft-card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1814;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.issue-draft-card__delete {
  min-width: 84rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 20rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  border: 0.5px solid #B8A882;
}

.issue-draft-card__collapse {
  min-width: 84rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 20rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  border: 0.5px solid #B8A882;
}

.issue-draft-card__body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.issue-draft-card__media {
  position: relative;
  width: 100%;
  border-radius: 2rpx;
  overflow: hidden;
  background: transparent;
}

.issue-draft-card__image {
  width: 100%;
  height: 280rpx;
  display: block;
  background: transparent;
}

.issue-draft-card__media-tip {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 0;
  background: rgba(17, 17, 17, 0.68);
  color: #F2EDE4;
  font-size: 18rpx;
  font-weight: 500;
}

.issue-draft-card__media-action {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.92);
  color: #1A1814;
  font-size: 18rpx;
  font-weight: 500;
}

.issue-draft-card__editor {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.issue-draft-card__badges {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.issue-draft-card__badge {
  padding: 8rpx 18rpx;
  border-radius: 0;
  background: transparent;
  color: #6B6355;
  font-size: 18rpx;
  font-weight: 400;
  border: 0.5px solid #B8A882;
}

.voice-hold {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.voice-hold-button {
  width: 100rpx;
  height: 100rpx;
  margin: 0;
  background: #1A1814;
  color: #D4C5A0;
  border: 1rpx solid rgba(17, 24, 39, 0.18);
  font-size: 18rpx;
  font-weight: 600;
  display: flex;
  flex-direction: column;
  gap: 0;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  letter-spacing: 0.2em;
  box-shadow: none;
}

.voice-hold-button--active {
  background: #1A1814;
  color: #D4C5A0;
}

.voice-hold-button__mic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.voice-hold-button__text {
  font-size: 20rpx;
  line-height: 1.2;
  color: #D4C5A0;
  font-weight: 600;
  transform: none;
}

.create-card__photo-button {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: auto;
  min-width: 240rpx;
  height: 84rpx;
  margin: 0;
  padding: 0 44rpx;
  border-radius: 0;
  background: #1A1814;
  color: #D4C5A0;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0.2em;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  z-index: 2;
}

.inspection-create__submit-button {
  position: static;
  transform: none;
  min-width: 240rpx;
  margin: 0 auto;
}

.issue-draft-card__transcribing {
  text-align: center;
  color: #6B6355;
  margin-top: -4rpx;
}

.issue-draft-card__textarea {
  width: 100%;
  min-height: 132rpx;
  border-radius: 0;
  background: transparent;
  border-bottom: 0.5px solid #E8E2D8;
  padding: 20rpx;
  color: #1A1814;
  font-size: 24rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.analyze-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 17, 17, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 1200;
}

.analyze-panel {
  width: 100%;
  max-width: 560rpx;
  padding: 40rpx 36rpx;
  border-radius: 4rpx;
  background: #F2EDE4;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  text-align: center;
  box-shadow: none;
}

.analyze-panel__spinner {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(17, 24, 39, 0.06);
  border-top-color: #B8A882;
  animation: analyze-spin 0.9s linear infinite;
}

.analyze-panel__title {
  font-size: 28rpx;
  color: #1A1814;
  font-weight: 400;
}

.analyze-panel__desc {
  font-size: 22rpx;
  line-height: 1.6;
  color: #6B6355;
}

@keyframes analyze-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.coach-tip {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 90;
  background: #1A1814;
  color: #FAF9F7;
  border-radius: 0;
  padding: 18rpx 20rpx;
}

.coach-tip__title {
  font-size: 26rpx;
  font-weight: 400;
}

.coach-tip__arrow {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B8A882;
}

.coach-tip__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.coach-tip__actions {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
}

.coach-tip__btn {
  flex: 1;
  height: 64rpx;
  border-radius: 0;
  background: #1A1814;
  color: #FAF9F7;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coach-tip__btn--ghost {
  background: transparent;
  border: 0.5px solid #B8A882;
  color: #6B6355;
}

.coach-highlight {
  position: relative;
  z-index: 120;
  box-shadow: 0 0 0 6rpx rgba(184, 168, 130, 0.35), 0 0 0 12rpx rgba(184, 168, 130, 0.2);
}
