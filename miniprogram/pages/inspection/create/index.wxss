.inspection-create-page{padding-bottom:calc(128rpx + env(safe-area-inset-bottom))}
.record-context{padding:20rpx 0;border-bottom:1px solid var(--a-line)}.record-context__label{font-size:26rpx;color:var(--a-muted);letter-spacing:.08em}.record-context__hint{margin-top:8rpx;font-size:26rpx;line-height:1.55;color:var(--a-muted)}
.record-project{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:52rpx;margin-top:4rpx;padding:4rpx 0;font-size:32rpx;font-weight:600}.record-project__name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--a-font-body);font-size:34rpx;font-weight:600}.record-project__action{font-size:26rpx;color:var(--a-active);font-weight:400;flex-shrink:0}
.capture-section{padding:24rpx 0;border-bottom:1px solid var(--a-line)}.capture-section__head{display:flex;justify-content:space-between;gap:20rpx;align-items:flex-start}.capture-section__title{font-family:var(--a-font-body);font-size:38rpx;font-weight:600;line-height:1.3}.capture-section__tools{display:flex;flex-direction:column;align-items:flex-end;gap:2rpx;flex:none}.capture-section__count{padding-top:5rpx;font-size:26rpx;white-space:nowrap;color:var(--a-muted);font-variant-numeric:tabular-nums}.capture-section__add{width:auto!important;min-height:44px;margin:0!important;padding:6rpx 0 0 16rpx!important;background:transparent;color:var(--a-active);font-size:26rpx;font-weight:600}.capture-section__action{width:100%!important;min-height:96rpx!important;margin:20rpx 0 0!important;padding:20rpx!important;display:flex;align-items:center;justify-content:center;gap:14rpx;background:var(--a-accent)!important;color:var(--a-accent-ink)!important;font-size:32rpx!important;font-weight:600;border-radius:var(--a-radius-control)}.capture-section__action-icon{width:42rpx;height:42rpx}
.create-card{padding:20rpx 0;border-bottom:1px solid var(--a-line)}.create-card__section-head,.create-card__issue-bar,.create-card__section-lead{display:flex;align-items:center;justify-content:space-between;gap:12rpx;flex-wrap:wrap}
.create-card__section-title{font-family:var(--a-font-body);font-size:34rpx;font-weight:600}.create-card__section-icon{width:36rpx;height:36rpx}.create-card__toggle{width:auto!important;min-height:44px;margin:0!important;display:flex;align-items:center;color:var(--a-muted);font-size:28rpx;padding:0 16rpx!important}
.create-card__issue-count{font-size:26rpx;color:#706D67}.create-card__photo-button{min-height:44px;display:flex;align-items:center;justify-content:center;padding:0 24rpx;border:1px solid #C9C1B7;font-size:28rpx}
.create-card__supplement-fields{padding-top:24rpx}
.issue-draft-list{display:flex;flex-direction:column;gap:0}.issue-draft-card{padding:24rpx 0 30rpx;border-bottom:1px solid var(--a-line)}.issue-draft-card__header,.issue-draft-card__header-actions{display:flex;align-items:center;justify-content:space-between;gap:8rpx}.issue-draft-card__title{font-family:var(--a-font-body);font-size:36rpx;font-weight:600}
.issue-draft-card__delete,.issue-draft-card__collapse{width:auto!important;margin:0!important;font-size:28rpx;min-height:44px;padding:0 16rpx!important;display:flex;align-items:center}.issue-draft-card__delete{color:var(--a-danger)}
.issue-draft-card__body{display:flex;flex-direction:column;gap:16rpx}.issue-draft-card__media{position:relative;background:var(--a-surface);margin-top:8rpx}
.issue-draft-card__media-open{width:100%!important;margin:0!important;padding:0!important;display:block;position:relative;background:transparent;border-radius:0}.issue-draft-card__image{width:100%;height:420rpx;display:block}.issue-draft-card__media-tip{position:absolute;left:16rpx;bottom:16rpx;padding:8rpx 12rpx;background:rgba(25,24,22,.82);color:var(--a-paper);font-size:26rpx}
.issue-draft-card__media-action{width:auto!important;position:absolute;right:16rpx;top:16rpx;min-height:44px;margin:0!important;padding:0 20rpx!important;display:flex;align-items:center;background:var(--a-paper);color:var(--a-ink);font-size:26rpx}
.issue-order{display:flex;align-items:center;justify-content:flex-end;gap:8rpx;color:var(--a-muted)}.issue-order__label{margin-right:auto;font-size:26rpx}.issue-order__button{width:auto!important;min-height:44px;margin:0!important;padding:0 14rpx!important;background:transparent;color:var(--a-active);font-size:26rpx}.issue-order__button[disabled]{color:var(--a-muted);opacity:.45}
.issue-draft-card__badges{display:flex;gap:16rpx;flex-wrap:wrap}.issue-draft-card__badge{font-size:26rpx;color:#706D67}
.voice-hold{margin:8rpx 0}.voice-hold-button{width:100%!important;min-height:52px;margin:0!important;border:1px solid var(--a-line);display:flex;align-items:center;justify-content:center;gap:16rpx;background:var(--a-surface);font-size:28rpx;border-radius:var(--a-radius-control)}.voice-hold-button--active{background:var(--a-accent);border-color:var(--a-accent);color:var(--a-accent-ink)}
.voice-hold-button__mic{width:40rpx;height:40rpx}.issue-draft-card__textarea{width:100%;min-height:120rpx;padding:20rpx 0;border-bottom:1px solid #C9C1B7;font-size:32rpx;line-height:1.65}
.create-ai-row{padding:20rpx 0 8rpx;text-align:center}.create-ai-link{width:auto!important;min-height:44px;margin:0 auto!important;padding:0 16rpx!important;background:transparent;color:var(--a-active);font-size:26rpx;text-decoration:underline;text-underline-offset:7rpx}.create-footer-actions{z-index:30}.analyze-mask{position:fixed;inset:0;background:rgba(25,24,22,.48);display:flex;align-items:center;justify-content:center;padding:36rpx;z-index:100}
.analyze-panel{width:100%;background:var(--a-paper);padding:40rpx;display:flex;flex-direction:column;align-items:center;gap:24rpx;text-align:center}.analyze-panel__title{font-family:var(--a-font-body);font-size:40rpx;font-weight:600}.analyze-panel__desc{font-size:28rpx;color:var(--a-muted)}.analyze-panel__cancel{width:auto!important;min-height:44px;margin:0!important;padding:0!important;display:flex;align-items:center;border-bottom:1px solid var(--a-ink);border-radius:0;font-size:28rpx}.analyze-panel__spinner{height:40rpx;width:40rpx;border:4rpx solid var(--a-line);border-top-color:var(--a-ink);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.create-card__photo-button{border-color:var(--a-accent-text);color:var(--a-accent-text);border-radius:var(--a-radius-control)}.voice-hold-button{border-color:var(--a-line);background:var(--a-surface);border-radius:var(--a-radius-control)}.voice-hold-button--active{background:var(--a-accent);border-color:var(--a-accent);color:var(--a-accent-ink)}.analyze-mask{background:rgba(25,24,22,.48)}
