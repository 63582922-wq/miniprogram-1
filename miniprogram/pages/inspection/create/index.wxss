.inspection-create-page {
  padding-bottom: calc(var(--a-space-capture-clearance) + env(safe-area-inset-bottom));
}

.record-context {
  padding: var(--a-space-2) 0;

}.capture-section__guidance,.capture-photo-status{
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.5;
}

.record-project {
  display: flex;
  min-height: var(--a-hit);
  align-items: center;
  justify-content: space-between;
  gap: var(--a-space-2);
  font-size: var(--a-type-body);
  font-weight:var(--a-weight-medium);
}

.record-project__name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--a-ink);
  font-size:var(--a-type-section);
  font-weight:var(--a-weight-emphasis);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-project__action {
  flex: none;
  color: var(--a-ink);
  font-size: var(--a-type-caption);
}

.capture-section {
  padding: var(--a-space-section) 0;

}

.capture-section__head,
.capture-photo-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--a-space-2);
}

.capture-section__title {
  color: var(--a-ink);
  font-size:var(--a-type-section);
  font-weight:var(--a-weight-emphasis);
  line-height: 1.35;
}

.capture-section__count,
.capture-photo-status {
  margin-left: var(--a-space-1);
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  font-weight:var(--a-weight-regular);
  white-space: nowrap;
}

.capture-section__action {
  display: flex;
  width: 100% !important;
  min-height: var(--a-hit-compact) !important;
  align-items: center;
  justify-content: center;
  gap: var(--a-space-2);
  margin: 0 !important;
  padding: var(--a-space-2) !important;
  border: 1px solid var(--a-accent);
  border-radius: var(--a-radius-pill);
  background: var(--a-accent) !important;
  color: var(--a-accent-ink) !important;
  font-size: var(--a-type-action) !important;
  font-weight:var(--a-weight-medium);
  line-height: 1.35;
}

.capture-section__action-icon {
  display: block;
  width: var(--a-icon);
  height: var(--a-icon);
  flex: none;
}

.capture-section__guidance {
  margin-top: var(--a-space-2);
}

.issue-draft-list {
  display: flex;
  flex-direction: column;
}

.issue-draft-card {
  padding: var(--a-space-3) 0;

}.issue-draft-card__header{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--a-space-1);
}

.issue-draft-card__collapse {
  display: flex;
  width: auto !important;
  min-height: var(--a-hit);
  align-items: center;
  gap: var(--a-space-1);
  margin: 0 !important;
  padding: 0 var(--a-space-1) 0 0 !important;
  color: var(--a-ink);
  font-size: var(--a-type-caption);
}

.issue-draft-card__title {
  font-size:var(--a-type-section);
  font-weight:var(--a-weight-emphasis);
}

.issue-draft-card__expand{flex:1;min-width:0;justify-content:space-between;align-self:stretch;min-height:var(--a-hit-compact)}

.issue-draft-card__body,
.issue-draft-card__editor {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
}

.issue-draft-card__body {
  padding-top: var(--a-space-2);
}

.issue-draft-card__media {
  position: relative;
  overflow: hidden;
  margin-top: var(--a-space-1);
  background: var(--a-photo-matte);
}

.issue-draft-card__media-open {
  position: relative;
  display: block;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent;
}

.issue-draft-card__image {
  display: block;
  width: 100%;
  height: auto;
}

.issue-draft-card__image-fallback {
  display: flex;
  width: 100%;
  height: 420rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--a-space-2);
  background: var(--a-field);
  color: var(--a-muted);
  font-size: var(--a-type-meta);
}.issue-draft-card__image-fallback-action{
  min-height: var(--a-hit);
  padding: 0 var(--a-space-2);
  background: var(--a-paper);
  color: var(--a-ink);
  font-size: var(--a-type-caption);
}

/* 对话式输入框：文字与语音合成一个框，麦克风在框内右侧。
   圆角用控件圆角而不是胶囊——这样输入框长高时不会被体育场形弧线切到文字。 */
/* 高度对齐同页的「继续添加」等按钮（--a-hit-primary）。
   原来 44(麦克风) + 8×2(内边距) + 1×2(边框) = 62px，比按钮高出一截，
   一排胶囊高低不齐。改为去掉纵向内边距并给最小高度，静止时与按钮同高；
   文字多行时容器仍会被撑高，圆角用半高半径所以不会甩字。 */
.issue-composer {
  display: flex;
  align-items: center;
  gap: var(--a-space-2);
  min-height: var(--a-hit-primary);
  padding: 0 var(--a-space-2);
  border: 1px solid var(--a-line);
  border-radius: var(--a-radius-bar);
  background: var(--a-field);
}

/* textarea 会把文字贴着自己的盒子顶部渲染。原先靠 min-height:44px 撑高度，
   多出来的 ~9px 全落在文字下方，于是输入框看着「文字偏高」。
   改为给上下等量内边距：单行时盒子 = 行高 + 上下内边距，在 52px 的容器里
   自然垂直居中；多行时上下留白对称，也不会贴边。 */
.issue-draft-card__textarea {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: var(--a-space-2) 0;
  border: 0;
  background: transparent;

  color: var(--a-ink);
  font-size: var(--a-type-body);
  line-height: 1.55;
}

.issue-draft-card__textarea::placeholder {
  color: var(--a-muted);
}

/* 触控区 44px、视觉圆 36px——两者分开。
   麦克风塞在 52px 的输入框里，圆若本身就是 44，四周只剩 4px，显得挤；
   但直接把按钮改小，又会让「按住说话」这个持续手势的落点低于标准触控高度。
   所以按钮保持 --a-hit（也是测试锁定的标准触控高度），圆画在 ::before 上。 */
.voice-hold-button {
  position: relative;
  display: flex;
  width: var(--a-hit) !important;
  height: var(--a-hit);
  min-height: var(--a-hit);
  flex: none;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  color: var(--a-ink) !important;
  user-select: none;
  transition: transform var(--a-motion);
}

.voice-hold-button::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 36px;
  height: 36px;
  /* 四边归零 + margin:auto 即为居中，且不必写负的原始边距
     （页面 WXSS 不允许出现原始间距数值）。 */
  margin: auto;
  box-sizing: border-box;
  border: 1.5px solid var(--a-accent);
  border-radius: var(--a-radius-pill);
  background: var(--a-accent-wash);
  transition: background-color var(--a-motion), border-color var(--a-motion);
}

/* 麦克风在框内放不下文字，录音中的状态改为框下一行提示，
   只在真正需要知道「松手完成 / 上滑取消」的时刻出现。 */
.voice-hold-status {
  /* 这行提示出现在麦克风正下方、横跨整行，左对齐会显得偏向一边；
     居中后与上面的输入框、下面的按钮同一中轴。 */
  padding-top: var(--a-space-1);
  color: var(--a-accent-text);
  font-size: var(--a-type-caption);
  line-height: 1.5;
  text-align: center;
}

.voice-hold-status--cancel {
  color: var(--a-danger);
}

.voice-hold-button--active { transform: scale(.99); }
.voice-hold-button--active::before {
  background: var(--a-accent-strong);
  border-color: var(--a-accent-strong);
}

.voice-hold-button--cancel { color: var(--a-white) !important; }
.voice-hold-button--cancel::before {
  background: var(--a-danger);
  border-color: var(--a-danger);
}

.voice-hold-button__mic {
  position: relative;
  z-index: 1;
  display: block;
  width: 18px;
  height: 18px;
  flex: none;
  filter: none;
}

.photo-processing-mode {
  display: flex;
  width: auto !important;
  min-height: var(--a-hit);
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  gap: var(--a-space-1);
  margin: 0 !important;
  padding: 0 var(--a-space-2) !important;
  border: 1px solid var(--a-line);
  border-radius: var(--a-radius-pill);
  background: var(--a-surface) !important;
  color: var(--a-ink);
  font-size: var(--a-type-caption);
}

.photo-processing-mode__value {
  color: var(--a-ink);
}

.photo-processing-mode__chevron {
  display: block;
  width: var(--a-icon-sm);
  height: var(--a-icon-sm);
  flex: none;
}

.photo-processing-mode--ai .photo-processing-mode__value {
  color: var(--a-accent-text);
}

.photo-processing-mode--ai {
  border-color: var(--a-accent) !important;
  background: var(--a-accent-wash) !important;
}

.photo-picker-status {
  display: flex;
  min-height: 48rpx;
  align-items: center;
  gap: var(--a-space-1);
  margin-top: var(--a-space-1);
  color: var(--a-muted);
  font-size: var(--a-type-caption);
}

.photo-picker-status__spinner,
.analyze-panel__spinner {
  box-sizing: border-box;
  border: 3rpx solid var(--a-line);
  border-top-color: var(--a-accent-text);
  border-radius: 50%;
  animation: precision-spin 1s linear infinite;
}

.photo-picker-status__spinner {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.speech-error-row {
  display: flex;
  align-items: center;
  gap: var(--a-space-2);
  padding: var(--a-space-1) 0;
}

.speech-error-row .precision-state {
  min-width: 0;
  flex: 1;
}

.speech-retry {
  display: flex;
  width: auto !important;
  min-height: var(--a-hit);
  align-items: center;
  margin: 0 !important;
  padding: 0 var(--a-space-1) !important;
  color: var(--a-accent-text) !important;
  font-size: var(--a-type-caption) !important;
  white-space: nowrap;
}

.photo-choice-mask,
.analyze-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  background: var(--a-photo-shade);
}

.photo-choice-mask {
  align-items: flex-end;
}

.photo-choice-panel {
  width: 100%;
  padding: var(--a-space-4) var(--a-page-inset) calc(var(--a-space-3) + env(safe-area-inset-bottom));
  border-radius: var(--a-radius-sheet) var(--a-radius-sheet) 0 0;
  background: var(--a-paper);
}

.photo-choice-title {
  margin: 0 0 var(--a-space-2);
  color: var(--a-ink);
  font-size:var(--a-type-object);
  font-weight:var(--a-weight-emphasis);
}

.photo-choice-option {
  display: flex;
  width: 100% !important;
  min-height: var(--a-hit-row);
  align-items: center;
  justify-content: flex-start;
  gap: var(--a-space-3);
  margin: 0 !important;
  padding: var(--a-space-2) 0 !important;

  text-align: left;
  font-size: var(--a-type-body);
}

.photo-choice-option__icon {
  display: block;
  width: var(--a-icon-lg);
  height: var(--a-icon-lg);
  flex: none;
}

.photo-choice-option__copy {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-1);
}

.photo-choice-later {
  display: flex;
  width: 100% !important;
  min-height: var(--a-hit);
  align-items: center;
  justify-content: center;
  margin: var(--a-space-1) 0 0 !important;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
}

.analyze-mask {
  z-index: 100;
  align-items: center;
  justify-content: center;
  padding: var(--a-page-inset);
}

.analyze-panel {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 620rpx;
  flex-direction: column;
  align-items: stretch;
  gap: var(--a-space-2);
  padding: var(--a-space-4);
  background: var(--a-paper);
  text-align: left;
}.analyze-panel__progress-head{
  color: var(--a-muted);
  font-size: var(--a-type-caption);
}

.analyze-panel__photo-progress {
  color: var(--a-muted);
  font-size: var(--a-type-caption);
  line-height: 1.5;
  word-break: break-word;
}

.analyze-panel__title {
  color: var(--a-ink);
  font-size:var(--a-type-callout);
  font-weight:var(--a-weight-emphasis);
}

.analyze-panel__desc {
  color: var(--a-muted);
  font-size: var(--a-type-meta);
}

.analyze-panel__progress {
  width: 100%;
  padding: var(--a-space-1) 0;
}

.analyze-panel__progress-head {
  display: flex;
  justify-content: space-between;
  gap: var(--a-space-2);
  margin-bottom: var(--a-space-1);
  font-variant-numeric: tabular-nums;
}

.analyze-panel__progress-track,
.analyze-panel__progress-value {
  height: 8rpx;
}

.analyze-panel__progress-track {
  overflow: hidden;
  background: var(--a-line);
}

.analyze-panel__progress-value {
  background: var(--a-accent);
  transition: width var(--a-motion);
}

.analyze-panel__error {
  padding: var(--a-space-2) 0;


  color: var(--a-danger);
  font-size: var(--a-type-caption);
  line-height: 1.6;
}

.analyze-panel__cancel {
  display: flex;
  width: auto !important;
  min-height: var(--a-hit);
  align-self: center;
  align-items: center;
  margin: 0 !important;
  padding: 0 var(--a-space-1) !important;
  color: var(--a-muted);
  font-size: var(--a-type-caption);
}

.analyze-panel__spinner {
  position: absolute;
  top: var(--a-space-4);
  right: var(--a-space-4);
  width: 32rpx;
  height: 32rpx;
}

@keyframes precision-spin {
  to { transform: rotate(360deg); }
}
.capture-ai-result { margin:var(--a-space-2) 0; padding:var(--a-space-2) var(--a-space-3); border-radius:var(--a-radius-control); background:var(--a-surface); color:var(--a-ink); font-size:var(--a-type-body); line-height:1.55; }

.issue-draft-card__image-fallback-action{border-radius:var(--a-radius-pill)}

/* 整行可点控件，内含 <view>，不是按键：退出全局胶囊圆角，否则
   体育场形弧线会切掉上下两端的文字。 */
.photo-choice-option.photo-choice-option{border-radius:0!important}
