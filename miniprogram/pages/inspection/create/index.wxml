<view class="page inspection-create-page">
  <page-nav-bar title="现场记录" showBack="{{true}}" autoBack="{{false}}" bind:backtap="handleReturn" />
  <view class="record-context"><picker range="{{projects}}" range-key="name" value="{{projectIndex}}" disabled="{{loadingProjects || pickingImages || analyzing}}" bindchange="handleProjectChange"><view class="record-project"><text class="record-project__name">{{currentProjectNameText}}</text><text class="record-project__action">更换项目</text></view></picker></view>
  <view wx:if="{{projectLoadError}}" class="precision-state">{{projectLoadError}}<button class="ui-button-reset secondary-button" bindtap="retryLoadProjects">重新加载</button></view>
  <view class="capture-section">
    <view class="capture-section__head ui-section-row"><view class="capture-section__title ui-section-row__label">现场照片 <text class="capture-section__count">{{form.issueDrafts.length}} / 20</text></view><button wx:if="{{form.issueDrafts.length > 1}}" class="ui-button-reset ui-section-row__action" bindtap="chooseAllPhotoProcessing">批量处理</button></view>
    <view wx:if="{{pickingImages}}" class="photo-picker-status" aria-live="polite"><view class="photo-picker-status__spinner"></view><text>{{pickerStatusText || '正在处理照片…'}}</text></view>
    <view wx:if="{{!form.issueDrafts.length && !pickingImages}}" class="capture-section__guidance">建议横向拍摄，竖图也支持。</view>
  </view>
  <view wx:if="{{pickerError}}" class="precision-state">{{pickerError}}<button class="ui-button-reset secondary-button" bindtap="chooseImages">重新选图</button></view>
  <view class="issue-draft-list">
    <view wx:for="{{form.issueDrafts}}" wx:key="id" id="capture-photo-{{index}}" class="issue-draft-card">
      <view class="issue-draft-card__header">
        <button class="ui-button-reset issue-draft-card__collapse issue-draft-card__expand" data-index="{{index}}" bindtap="toggleIssueExpanded"><text class="issue-draft-card__title">照片 {{issueSectionTitles[index] || (index + 1)}}</text><text class="capture-photo-status">{{item.analysisModeResolved === 'ai' ? 'AI 识图' : item.voiceText ? '已说明' : item.annotationCount ? '已标注' : ''}}</text></button>
        <button class="ui-button-reset issue-draft-card__collapse" data-index="{{index}}" bindtap="handlePhotoMenu">更多</button>
      </view>
      <view wx:if="{{issueExpandedStates[index]}}" class="issue-draft-card__body">
        <view class="issue-draft-card__media"><view class="issue-draft-card__media-open" aria-label="标注照片" data-index="{{index}}" bindtap="openAnnotate">
          <image wx:if="{{failedPhotoPreviewId !== item.id}}" class="issue-draft-card__image" src="{{item.displayImagePath || item.localAnnotatedImagePath || item.localImagePath || item.annotatedImagePath || item.imagePath}}" mode="widthFix" binderror="handlePhotoPreviewError" data-id="{{item.id}}" />
          <view wx:else class="issue-draft-card__image-fallback"><text>照片暂时无法显示</text><button class="ui-button-reset issue-draft-card__image-fallback-action" data-id="{{item.id}}" data-index="{{index}}" catchtap="replaceIssueImage">重新选图</button></view>
        </view></view>
        <view class="capture-photo-actions">
          <button class="ui-button-reset photo-processing-mode {{analyzing || pickingImages ? 'ui-disabled' : ''}}" disabled="{{analyzing || pickingImages}}" data-id="{{item.id}}" data-index="{{index}}" bindtap="recognizePhoto"><text>{{item.aiRecognized ? '重新识图' : 'AI识图'}}</text></button>
          <button class="ui-button-reset photo-processing-mode" data-index="{{index}}" bindtap="openAnnotate"><image class="capture-section__action-icon" src="/images/icons/annotation-rectangle.svg" mode="aspectFit"/><text>标注{{item.annotationCount ? ' · '+item.annotationCount : ''}}</text></button>
        </view>
        <view wx:if="{{item.aiRecognized}}" class="capture-ai-result"><view wx:for="{{item.aiIssues}}" wx:for-item="problem" wx:key="*this">{{problem}}</view><text wx:if="{{!item.aiIssues.length}}">未识别到明确问题，可直接补充说明。</text></view>
        <view class="issue-draft-card__editor">
          <view class="issue-composer">
            <textarea auto-height maxlength="5000" class="issue-draft-card__textarea" value="{{item.voiceText}}" data-id="{{item.id}}" data-index="{{index}}" bindinput="handleIssueVoiceTextInput" placeholder="输入现场说明或问题描述" placeholder-class="ui-placeholder" />
            <button class="ui-button-reset voice-hold-button {{transcribingIssueId === item.id ? 'voice-hold-button--active' : ''}} {{recordCancelArmed && transcribingIssueId === item.id ? 'voice-hold-button--cancel' : ''}} {{item.isTranscribing ? 'ui-disabled' : ''}}" disabled="{{item.isTranscribing}}" aria-label="按住说话，松开发送；录错向上滑动取消" data-index="{{index}}" bindtouchstart="handleRecordTouchStart" catchtouchmove="handleRecordMove" bindtouchend="handleRecordTouchEnd" bindtouchcancel="handleRecordCancel"><image class="voice-hold-button__mic" src="/images/icons/icon-mic.svg" mode="aspectFit" /><view class="voice-hold-button__copy"><text>{{item.isTranscribing ? '正在转成文字…' : transcribingIssueId === item.id ? (recordCancelArmed ? '松开，取消这段' : '松开，完成转写') : '按住说话'}}</text><text class="voice-hold-button__hint">{{transcribingIssueId === item.id ? (recordCancelArmed ? '已进入取消状态' : '向上滑动可取消') : '松开转文字 · 上滑取消'}}</text></view></button>
          </view>
          <view wx:if="{{item.speechError}}" class="speech-error-row">
            <view class="precision-state">{{item.speechError}}</view>
            <button class="ui-button-reset speech-retry {{item.isTranscribing ? 'ui-disabled' : ''}}" data-index="{{index}}" disabled="{{item.isTranscribing}}" bindtap="retryIssueTranscription">重试转写</button>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{form.issueDrafts.length < 20}}" class="capture-section__picker-actions">
    <button class="ui-button-reset secondary-button {{pickingImages || analyzing ? 'ui-disabled' : ''}}" disabled="{{pickingImages || analyzing}}" loading="{{pickingImages}}" hover-class="is-pressed" bindtap="chooseImages"><image class="capture-section__action-icon" src="/images/icons/icon-gallery.svg" mode="aspectFit" /><text>继续添加</text></button>
  </view>
  <view wx:if="{{form.issueDrafts.length}}" class="create-card">
    <view class="create-card__section-head"><button class="ui-button-reset create-card__toggle" bindtap="toggleSupplementFields">{{showSupplementFields ? '收起巡查信息' : '巡查信息（选填）'}}</button></view>
      <view wx:if="{{showSupplementFields}}" class="create-card__supplement-fields">
      <view class="field"><view class="field-label">报告标题</view><input class="field-input" value="{{form.title}}" data-field="title" bindinput="handleInput" placeholder="本次现场记录" placeholder-class="ui-placeholder" /></view>
      <view class="field"><view class="field-label">现场补充说明</view><textarea class="field-textarea" value="{{form.note}}" data-field="note" bindinput="handleInput" placeholder="选填：补充整次巡查的背景" placeholder-class="ui-placeholder" /></view>
    </view>
  </view>
  <view wx:if="{{form.issueDrafts.length}}" class="footer-actions footer-actions--fixed"><button class="ui-button-reset primary-button {{analyzing || pickingImages ? 'ui-disabled' : ''}}" disabled="{{analyzing || pickingImages}}" bindtap="handleContinueReview">{{nextActionLabel}}</button></view>
  <view wx:if="{{photoChoiceOpen}}" class="photo-choice-mask" catchtap="deferPhotoProcessing">
    <view class="photo-choice-panel" catchtap="ignoreTap">
      <view class="photo-choice-title ui-sheet-title">{{photoChoiceIds.length > 1 ? '这 '+photoChoiceIds.length+' 张照片怎么整理？' : '这张照片怎么整理？'}}</view>
      <button class="ui-button-reset photo-choice-option" data-mode="manual" bindtap="choosePhotoProcessing"><image class="photo-choice-option__icon" src="/images/icons/icon-note.svg" mode="aspectFit" /><view class="photo-choice-option__copy"><text>仅手动填写</text><text class="section-subtitle">说或写，AI 帮你填表</text></view></button>
      <button class="ui-button-reset photo-choice-option" data-mode="ai" bindtap="choosePhotoProcessing"><image class="photo-choice-option__icon" src="/images/icons/icon-inspection.svg" mode="aspectFit" /><view class="photo-choice-option__copy"><text>{{photoChoiceIds.length > 1 ? '全部交给 AI 识图' : 'AI 识图'}}</text><text class="section-subtitle">识别结果由你核对</text></view></button>
      <button class="ui-button-reset photo-choice-later" bindtap="deferPhotoProcessing">先保留照片</button>
    </view>
  </view>
  <view wx:if="{{analyzing || analyzeError}}" class="analyze-mask">
    <view class="analyze-panel">
      <view wx:if="{{analyzing}}" class="analyze-panel__spinner"></view>
      <view class="analyze-panel__title">{{analyzeError ? '部分记录未完成' : analyzeStageIndex === 1 ? '正在保存照片' : analyzePanelTitle}}</view>
      <view class="analyze-panel__desc">{{analyzeStageText}}</view>
      <view wx:if="{{analyzeTotalPhotos && analyzeStageIndex !== 1}}" class="analyze-panel__progress"><view class="analyze-panel__progress-head"><text>{{analyzeProgressLabel}} {{analyzeCompletedPhotos}} / {{analyzeTotalPhotos}}</text><text>{{analyzeProgressPercent}}%</text></view><view class="analyze-panel__progress-track"><view class="analyze-panel__progress-value" style="width:{{analyzeProgressPercent}}%"></view></view></view>
      <view wx:if="{{analyzePhotoProgressText}}" class="analyze-panel__photo-progress">{{analyzePhotoProgressText}}</view>
      <view wx:if="{{analyzeError}}" class="analyze-panel__error">{{analyzeError}}</view>
      <button wx:if="{{analyzeError}}" class="ui-button-reset primary-button" bindtap="handleRetryAnalyze">重试未完成照片</button>
      <button wx:if="{{analyzeError}}" class="ui-button-reset analyze-panel__cancel" bindtap="handleAnalyzeManualFallback">直接人工核对</button>
      <button wx:else class="ui-button-reset analyze-panel__cancel" bindtap="handleCancelAnalyze">返回记录</button>
    </view>
  </view>
</view>
