.annotate-page{min-height:100vh;padding-bottom:0;display:flex;flex-direction:column}.annotate-page .footer-actions{margin-top:auto;padding-left:0;padding-right:0}

.annotate-hint {
  padding: 18rpx 22rpx;
  border-radius: 0;
  background: var(--a-surface, #E2DCD3);
  border: 0.5px solid var(--a-line, #C9C1B7);
  font-size: 26rpx;
  color: var(--a-muted, #706D67);
  text-align: center;
  line-height: 1.6;
}

.export-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
