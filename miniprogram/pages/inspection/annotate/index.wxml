<view class="page annotate-page">
 <page-nav-bar title="精准标注" showBack="{{true}}" autoBack="{{false}}" bind:backtap="handleBackTap"/>
 <view wx:if="{{storageError}}" class="precision-state">{{storageError}}</view>
 <annotation-canvas id="annotationEditor" image-url="{{imagePath}}" value="{{annotations}}" legacy-stage="{{annotationStage}}" bindchange="handleAnnotationChange" bindstagechange="handleStageChange" bindnormalized="handleNormalized" bindready="handleEditorReady" binderror="handleEditorError"/>
 <view wx:if="{{editorError}}" class="precision-state">{{editorError}}</view>
 <view class="footer-actions"><button class="primary-button" loading="{{saving}}" disabled="{{saving || !editorReady}}" bindtap="handleSave">{{editorReady ? '保存标注并返回' : '照片加载中…'}}</button></view>
</view>
