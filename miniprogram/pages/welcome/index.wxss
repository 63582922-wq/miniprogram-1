.welcome-brand{display:flex;align-items:center;gap:var(--a-space-2);margin-top:var(--a-space-7)}.welcome-brand__mark{width:76rpx;height:76rpx;flex:none}.welcome-wordmark{font-family:var(--a-font-body);font-size:var(--a-type-section);font-weight:var(--a-weight-medium);letter-spacing:0;line-height:1.2}.welcome-brand__desc{margin-top:var(--a-space-1);color:var(--a-muted);font-size:var(--a-type-caption);letter-spacing:.04em}.welcome-title{margin:var(--a-space-headline-offset) 0 var(--a-space-4);font-family:var(--a-font-body);font-size:var(--a-type-welcome);line-height:1.2;font-weight:var(--a-weight-emphasis);letter-spacing:-.6rpx}.welcome-copy{color:var(--a-muted);margin:var(--a-space-4) 0;font-size:var(--a-type-action)}.welcome-consent{display:flex;align-items:center;flex-wrap:wrap;margin:var(--a-space-8) 0 var(--a-space-3);font-size:var(--a-type-caption);min-height:var(--a-hit)}.welcome-consent__choice{min-height:var(--a-hit);display:flex;align-items:center}.welcome-link{width:auto!important;min-height:var(--a-hit);margin:0!important;padding:var(--a-space-2)!important;background:transparent;color:var(--a-active);font-size:var(--a-type-caption);text-decoration:underline}.welcome-link::after{border:0}.welcome-page{padding-bottom:calc(var(--a-space-5) + env(safe-area-inset-bottom))}
.welcome-brand .welcome-brand__mark{width:96rpx;height:96rpx;border-radius:var(--a-radius-brand);overflow:hidden}
