.welcome-brand{display:flex;align-items:center;gap:18rpx;margin-top:56rpx}.welcome-brand__mark{width:76rpx;height:76rpx;flex:none}.welcome-wordmark{font-family:var(--a-font-display);font-size:34rpx;font-weight:500;letter-spacing:1rpx;line-height:1.2}.welcome-brand__desc{margin-top:6rpx;color:var(--a-muted);font-size:26rpx;letter-spacing:.04em}.welcome-title{margin:42rpx 0 32rpx;font-family:var(--a-font-body);font-size:68rpx;line-height:1.2;font-weight:600;letter-spacing:-.6rpx}.welcome-copy{color:var(--a-muted);margin:28rpx 0;font-size:30rpx}.welcome-consent{display:flex;align-items:center;flex-wrap:wrap;margin:64rpx 0 24rpx;font-size:26rpx;min-height:44px}.welcome-consent__choice{min-height:44px;display:flex;align-items:center}.welcome-link{width:auto!important;min-height:44px;margin:0!important;padding:12rpx!important;background:transparent;color:var(--a-active);font-size:26rpx;text-decoration:underline}.welcome-link::after{border:0}.welcome-page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
