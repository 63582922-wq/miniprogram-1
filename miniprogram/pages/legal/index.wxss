.legal-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.legal-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.legal-title {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
  letter-spacing: 0.04em;
}

.legal-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--a-muted, #706D67);
}

.legal-text.sub {
  padding-left: 32rpx;
  color: var(--a-muted, #706D67);
}

.legal-hint {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--a-muted, #706D67);
}
