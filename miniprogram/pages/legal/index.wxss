.legal-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.legal-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.legal-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #1A1814;
  letter-spacing: 0.04em;
}

.legal-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #6B6355;
}

.legal-text.sub {
  padding-left: 32rpx;
  color: #6B6355;
}

.legal-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6B6355;
}
