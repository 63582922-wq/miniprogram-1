<view class="page project-page">
  <page-nav-bar title="" />
  <product-identity />
  <view class="root-section-heading"><view class="root-section-heading__title">全部项目</view><button class="compact-action" bindtap="goCreate" hover-class="is-pressed">新建项目</button></view>
  <view class="project-search">
    <input class="field-input project-search__input" placeholder="搜索项目名称或地址" value="{{keyword}}" bindinput="handleKeywordInput" confirm-type="search" bindconfirm="handleSearch" />
  </view>
  <view wx:if="{{selectingProject}}" class="selection-hint">选择记录所属项目<button bindtap="cancelSelection">取消</button></view>

  <view wx:if="{{projectList.length}}" class="list">
    <view wx:for="{{projectList}}" wx:key="_id" class="project-row">
      <project-card project="{{item}}" bindopen="openDetail" bindlongpress="handleProjectLongPress" />
    </view>
  </view>

  <view wx:if="{{loadError}}" class="precision-state">{{loadError}}<button class="secondary-button" bindtap="loadProjects">重新加载</button></view>
  <view wx:elif="{{loading}}" class="precision-state">正在加载项目…</view>
  <empty-state wx:elif="{{!projectList.length && keyword}}" title="没有找到项目" description="试试其他名称或地址" />
  <empty-state
    wx:elif="{{!projectList.length}}"
    title="还没有项目"
    description="每次巡查都要归属到一个项目。先建一个，然后就能拍照、记录问题、生成报告。"
    actionText="创建第一个项目"
    bindaction="goCreate"
  />
  <button wx:if="{{hasMore && !loading && !loadError}}" class="secondary-button" bindtap="onReachBottom">加载更多</button>
  <view class="project-record-action"><button class="primary-button" bindtap="startRecord" hover-class="is-pressed"><image src="/images/icons/icon-tab-camera.svg" />开始现场记录</button></view>
</view>
