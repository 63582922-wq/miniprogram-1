.project-gallery-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.gallery-summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gallery-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gallery-card {
  background: var(--a-surface, #E2DCD3);
  border-radius: 4rpx;
  overflow: hidden;
  border: none;
  box-shadow: none;
}

.gallery-card__image {
  width: 100%;
  height: 320rpx;
  background: var(--a-surface, #E2DCD3);
  display: block;
}

.gallery-card__preview {
  width: 100%!important;
  margin: 0!important;
  padding: 0!important;
  display: block;
  background: transparent;
  border-radius: 0;
}

.gallery-card__preview::after,
.gallery-card__link::after {
  border: 0;
}

.gallery-card__meta {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gallery-card__title {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
}

.gallery-card__desc {
  font-size: 26rpx;
  color: var(--a-muted, #706D67);
  line-height: 1.5;
}

.gallery-card__link {
  margin: 8rpx 0 0!important;
  width: fit-content;
  min-width: 132rpx;
  height: 44rpx;
  padding: 0 16rpx!important;
  border-radius: 0;
  background: transparent;
  border: 0.5px solid var(--a-line, #C9C1B7);
  font-size: 26rpx;
  color: var(--a-muted, #706D67);
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
}
