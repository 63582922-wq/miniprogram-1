.project-gallery-page {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
}

.gallery-summary {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
}

.gallery-grid {
  display: flex;
  flex-direction: column;
  gap: var(--a-space-2);
}

.gallery-card {
  background: var(--a-surface);
  border-radius: var(--a-radius-tight);
  overflow: hidden;
  border: none;
  box-shadow: none;
}

.gallery-card__image {
  width: 100%;
  height: 320rpx;
  background: var(--a-surface);
  display: block;
}

.gallery-card__image-fallback {
  width: 100%;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--a-muted);
  background: var(--a-surface);
  font-size:var(--a-type-caption);
}

.gallery-card__preview {
  width: 100%!important;
  margin: 0!important;
  padding: 0!important;
  display: block;
  background: transparent;
  border-radius: 0;
}

.gallery-card__preview::after,
.gallery-card__link::after {
  border: 0;
}

.gallery-card__meta {
  padding: var(--a-space-2);
  display: flex;
  flex-direction: column;
  gap: var(--a-space-1);
}

.gallery-card__title {
  font-size:var(--a-type-medium);
  font-weight:var(--a-weight-regular);
  color: var(--a-ink);
}

.gallery-card__desc {
  font-size:var(--a-type-caption);
  color: var(--a-muted);
  line-height: 1.5;
}

.gallery-card__link {
  margin: var(--a-space-1) 0 0!important;
  width: auto!important;
  min-width: 132rpx;
  min-height: var(--a-hit);
  padding: 0 var(--a-space-2)!important;
  border-radius: 0;
  background: transparent;
  border: 0.5px solid var(--a-line);
  font-size:var(--a-type-caption);
  color: var(--a-accent-text);
  font-weight:var(--a-weight-regular);
  display: flex;
  align-items: center;
  justify-content: center;
}
