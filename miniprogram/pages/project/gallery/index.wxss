.project-gallery-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.gallery-summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gallery-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gallery-card {
  background: #F2EDE4;
  border-radius: 4rpx;
  overflow: hidden;
  border: none;
  box-shadow: none;
}

.gallery-card__image {
  width: 100%;
  height: 320rpx;
  background: #F2EDE4;
  display: block;
}

.gallery-card__meta {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gallery-card__title {
  font-size: 28rpx;
  font-weight: 400;
  color: #1A1814;
}

.gallery-card__desc {
  font-size: 22rpx;
  color: #6B6355;
  line-height: 1.5;
}

.gallery-card__link {
  margin-top: 8rpx;
  width: fit-content;
  min-width: 132rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 0;
  background: transparent;
  border: 0.5px solid #B8A882;
  font-size: 20rpx;
  color: #6B6355;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
}
