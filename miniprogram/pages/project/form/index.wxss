.project-form-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.coach-field-highlight {
  border-radius: 0;
  padding: 10rpx;
  margin: -10rpx;
  box-shadow: 0 0 0 4rpx rgba(184, 168, 130, 0.35);
}

.coach-tip {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: calc(env(safe-area-inset-top) + 110rpx);
  z-index: 99;
  background: #1A1814;
  color: #FAF9F7;
  border-radius: 0;
  padding: 18rpx 20rpx;
}

.coach-mask {
  position: fixed;
  inset: 0;
  z-index: 96;
  background: rgba(26, 24, 20, 0.28);
  pointer-events: none;
}

.coach-target-hint {
  position: fixed;
  right: 34rpx;
  bottom: calc(env(safe-area-inset-bottom) + 150rpx);
  z-index: 121;
  padding: 10rpx 14rpx;
  border-radius: 0;
  background: #B8A882;
  color: #1A1814;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  animation: coachHintPulse 1.4s ease-in-out infinite;
}

.coach-target-hint__arrow {
  font-size: 26rpx;
}

.coach-tip__title {
  font-size: 26rpx;
  font-weight: 400;
  color: #FAF9F7;
  letter-spacing: 0.04em;
}

.coach-tip__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #D4C5A0;
}

.coach-tip__btn {
  margin-top: 14rpx;
  height: 64rpx;
  border-radius: 0;
  background: #1A1814;
  color: #D4C5A0;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.2em;
}

.coach-tip__btn--ghost {
  background: transparent;
  border: 0.5px solid #B8A882;
  color: #6B6355;
}

.coach-highlight {
  position: relative;
  z-index: 120;
  box-shadow: 0 0 0 6rpx rgba(184, 168, 130, 0.35), 0 0 0 12rpx rgba(184, 168, 130, 0.2);
  animation: coachTargetPulse 1.4s ease-in-out infinite;
}

@keyframes coachTargetPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

@keyframes coachHintPulse {
  0%, 100% {
    opacity: 0.88;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-2rpx);
  }
}
