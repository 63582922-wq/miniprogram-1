.project-form-page{display:flex;flex-direction:column;gap:0;padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}
.project-form-intro{padding:24rpx 0 20rpx;margin-bottom:24rpx;border-bottom:1px solid var(--a-line);font-size:26rpx;line-height:1.65;color:var(--a-muted)}
.form-expand{width:100%!important;min-height:44px;margin:0!important;padding:16rpx 0!important;border-top:1px solid var(--a-line);border-bottom:1px solid var(--a-line);border-radius:0;background:transparent;color:var(--a-active);font-size:28rpx;text-align:left}
.form-optional{padding-top:28rpx;border-bottom:1px solid var(--a-line)}
