.project-detail-page{padding-bottom:56rpx}.project-hero{padding:30rpx 0 26rpx}.project-hero__head,.project-feature__caption,.project-progress{display:flex;justify-content:space-between;gap:24rpx}.project-hero__head{align-items:center}.project-hero__eyebrow,.project-section__label{font-size:26rpx;line-height:1.4;color:var(--a-muted);letter-spacing:.08em}.project-hero__edit{width:auto!important;min-height:44px;margin:0!important;padding:0!important;color:var(--a-muted);font-size:26rpx}.project-hero__title{margin-top:10rpx;font-family:var(--a-font-display);font-size:58rpx;line-height:1.2;font-weight:500;letter-spacing:1rpx;word-break:break-word}.project-hero__title--ui{font-family:var(--a-font-body);font-size:52rpx;font-weight:600;letter-spacing:-.4rpx}.project-hero__address{margin-top:10rpx;font-size:30rpx;color:var(--a-muted);line-height:1.55}.project-hero__meta{margin-top:6rpx;font-size:26rpx;line-height:1.6;color:var(--a-muted)}
.project-feature{padding:4rpx 0 26rpx;border-bottom:1px solid var(--a-line)}.project-feature__media{position:relative;width:100%!important;height:540rpx;margin:0!important;padding:0!important;display:block;background:var(--a-surface);overflow:hidden;border-radius:0}.project-feature__image{width:100%;height:100%;display:block}.project-feature__count{position:absolute;right:18rpx;bottom:18rpx;padding:8rpx 16rpx;border-radius:999rpx;background:rgba(25,24,22,.72);color:var(--a-paper);font-size:26rpx;font-variant-numeric:tabular-nums}.project-feature__caption{align-items:flex-start;padding-top:18rpx}.project-feature__copy{min-width:0;flex:1}.project-feature__title{font-family:var(--a-font-display);font-size:36rpx;font-weight:500;line-height:1.35;letter-spacing:.3rpx}.project-feature__desc{margin-top:5rpx;color:var(--a-muted);font-size:26rpx;line-height:1.55}.project-feature__meta{display:flex;flex-direction:column;align-items:flex-end;gap:4rpx;max-width:46%;color:var(--a-muted);font-size:26rpx;line-height:1.45;text-align:right;font-variant-numeric:tabular-nums}
.project-progress{align-items:stretch;padding:30rpx 0}.project-progress__main{flex:1;min-width:0}.project-progress__title{margin-top:12rpx;font-family:var(--a-font-display);font-size:48rpx;font-weight:500;letter-spacing:.5rpx;line-height:1.25}.project-progress__desc{margin-top:16rpx;color:var(--a-muted);font-size:28rpx}.project-progress__aside{min-width:150rpx;padding-left:28rpx;border-left:1px solid var(--a-line)}.project-progress__number{display:inline-block;margin-top:10rpx;font-family:var(--a-font-display);font-size:48rpx;line-height:1}.project-progress__unit{display:inline-block;margin-left:8rpx;color:var(--a-muted);font-size:26rpx}.project-hero__action{margin:0 0 10rpx!important}.project-hero__action image{width:42rpx;height:42rpx;margin-right:14rpx}
.project-section{padding:28rpx 0;border-bottom:1px solid var(--a-line)}.project-section--compact{padding:24rpx 0}.project-section__head{display:flex;align-items:center;justify-content:space-between}.project-section__head button{width:auto!important;min-height:44px;margin:0!important;padding:0 0 0 20rpx;color:var(--a-active);font-size:26rpx}.project-shortcuts{display:grid;grid-template-columns:repeat(3,1fr);margin-top:12rpx}.project-shortcuts button{width:100%!important;min-height:60px;margin:0!important;padding:12rpx 0!important;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:2rpx;border-right:1px solid var(--a-line);font-size:28rpx}.project-shortcuts button:last-child{border-right:0}.project-shortcuts button text:last-child{font-family:var(--a-font-display);font-size:34rpx}.project-plain-row{width:100%!important;min-height:68px;margin:0!important;padding:16rpx 0!important;display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:transparent;text-align:left;border-bottom:1px solid var(--a-line)}.project-plain-row:last-child{border-bottom:0}.project-plain-row>view{min-width:0}.project-plain-row__title{font-size:31rpx;line-height:1.4;font-weight:600}.project-plain-row__desc{margin-top:4rpx;font-size:26rpx;line-height:1.5;color:var(--a-muted)}.project-plain-row image{width:28rpx;height:28rpx;flex:none}.project-empty{padding:20rpx 0 0;font-size:26rpx;color:var(--a-muted)}
