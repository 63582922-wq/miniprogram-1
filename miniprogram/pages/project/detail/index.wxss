.project-detail-page{padding-bottom:calc(var(--a-space-7) + env(safe-area-inset-bottom))}.project-hero{padding:var(--a-space-4) 0 var(--a-space-3)}.project-hero__head,.project-feature__caption{display:flex;justify-content:space-between;gap:var(--a-space-3)}.project-hero__head{align-items:center}.project-hero__eyebrow,.project-section__label{font-size:var(--a-type-caption);line-height:1.4;color:var(--a-muted);letter-spacing:.08em}.project-hero__edit{width:auto!important;min-height:var(--a-hit);margin:0!important;padding:0!important;color:var(--a-muted);font-size:var(--a-type-caption)}.project-hero__title{margin-top:var(--a-space-1);font-family:var(--a-font-display);font-size:var(--a-type-project-title);line-height:1.2;font-weight:var(--a-weight-regular);letter-spacing:1rpx;word-break:break-word}.project-hero__title--ui{font-family:var(--a-font-body);font-size:var(--a-type-project-title-ui);font-weight:var(--a-weight-emphasis);letter-spacing:-.4rpx}.project-hero__address{margin-top:var(--a-space-1);font-size:var(--a-type-action);color:var(--a-muted);line-height:1.55}.project-hero__meta{margin-top:var(--a-space-1);font-size:var(--a-type-caption);line-height:1.6;color:var(--a-muted)}
.project-feature{padding:var(--a-space-1) 0 var(--a-space-3);}.project-feature__media{position:relative;width:100%!important;height:540rpx;margin:0!important;padding:0!important;display:block;background:var(--a-surface);overflow:hidden;border-radius:0}.project-feature__image{width:100%;height:100%;display:block}.project-feature__count{position:absolute;right:18rpx;bottom:18rpx;padding:var(--a-space-1) var(--a-space-2);border-radius:var(--a-radius-pill);background:var(--a-photo-overlay);color:var(--a-paper);font-size:var(--a-type-caption);font-variant-numeric:tabular-nums}.project-feature__caption{display:block;padding-top:var(--a-space-2)}.project-feature__copy{min-width:0;flex:1}.project-feature__title{font-family:var(--a-font-display);font-size:var(--a-type-object);font-weight:var(--a-weight-medium);line-height:1.35;letter-spacing:.3rpx}.project-feature__desc{margin-top:var(--a-space-1);color:var(--a-muted);font-size:var(--a-type-caption);line-height:1.55}.project-feature__meta{display:flex;flex-direction:column;align-items:flex-start;gap:var(--a-space-1);max-width:none;margin-top:var(--a-space-1);color:var(--a-muted);font-size:var(--a-type-caption);line-height:1.45;text-align:left;font-variant-numeric:tabular-nums}
.project-hero__action{margin:0 0 var(--a-space-1)!important}.project-hero__action-icon{width:42rpx;height:42rpx;margin-right:var(--a-space-2)}
.project-gallery-link{width:100%!important;min-height:var(--a-hit-compact);margin:0!important;padding:var(--a-space-1) 0!important;display:flex;align-items:center;gap:var(--a-space-2);border:0;border-radius:0;background:transparent;color:var(--a-ink);font-size:var(--a-type-medium);text-align:left}.project-gallery-link__count{margin-left:auto;color:var(--a-muted);font-size:var(--a-type-caption)}.project-gallery-link__icon{width:28rpx;height:28rpx;flex:none}
.project-section{padding:var(--a-space-4) 0;}.project-section--compact{padding:var(--a-space-3) 0}.project-section__head{display:flex;align-items:center;justify-content:space-between}.project-section__action{width:auto!important;min-height:var(--a-hit);margin:0!important;padding:0 0 0 var(--a-space-2);color:var(--a-active);font-size:var(--a-type-caption)}.project-plain-row{width:100%!important;min-height:var(--a-hit-row);margin:0!important;padding:var(--a-space-2) 0!important;display:flex;align-items:center;justify-content:space-between;gap:var(--a-space-2);background:transparent;text-align:left;}.project-plain-row--last{border-bottom:0}.project-plain-row__content{min-width:0}.project-plain-row__title{font-size:var(--a-type-row);line-height:1.4;font-weight:var(--a-weight-emphasis)}.project-plain-row__desc{margin-top:var(--a-space-1);font-size:var(--a-type-caption);line-height:1.5;color:var(--a-muted)}.project-plain-row__icon{width:28rpx;height:28rpx;flex:none}.project-empty{padding:var(--a-space-2) 0 0;font-size:var(--a-type-caption);color:var(--a-muted)}
.project-section__hint{min-height:var(--a-hit);display:flex;align-items:center;color:var(--a-muted);font-size:var(--a-type-caption)}
.capture-choice-mask{position:fixed;inset:0;z-index:90;display:flex;align-items:flex-end;background:var(--a-photo-shade)}.capture-choice-panel{width:100%;padding:var(--a-space-4) var(--a-page-inset) calc(var(--a-space-3) + env(safe-area-inset-bottom));border-radius:var(--a-radius-sheet) var(--a-radius-sheet) 0 0;background:var(--a-paper)}.capture-choice-title{font-size:var(--a-type-object);line-height:1.35;font-weight:var(--a-weight-emphasis);color:var(--a-ink)}.capture-choice-subtitle{margin:var(--a-space-1) 0 var(--a-space-3);font-size:var(--a-type-caption);line-height:1.5;color:var(--a-muted)}.capture-choice-option{width:100%!important;min-height:var(--a-hit-primary);margin:0 0 var(--a-space-2)!important;padding:0 var(--a-space-3)!important;display:flex;align-items:center;justify-content:center;gap:var(--a-space-2);border:1px solid var(--a-line);background:var(--a-surface);color:var(--a-ink);font-size:var(--a-type-action)}.capture-choice-option__icon{width:var(--a-icon-lg);height:var(--a-icon-lg)}.capture-choice-option--primary{border-color:var(--a-accent);background:var(--a-accent);color:var(--a-accent-ink)}.capture-choice-cancel{width:100%!important;min-height:var(--a-hit);margin:0!important;color:var(--a-muted);font-size:var(--a-type-body)}
.capture-saving-mask{position:fixed;inset:0;z-index:91;display:flex;align-items:center;justify-content:center;background:var(--a-photo-shade)}.capture-saving-panel{min-width:260rpx;padding:var(--a-space-3) var(--a-space-4);display:flex;align-items:center;justify-content:center;gap:var(--a-space-2);border-radius:var(--a-radius-sheet);background:var(--a-paper);color:var(--a-ink);font-size:var(--a-type-body)}.capture-saving-indicator{width:28rpx;height:28rpx;border:3rpx solid var(--a-line);border-top-color:var(--a-accent-strong);border-radius:50%;animation:captureSavingSpin .8s linear infinite}@keyframes captureSavingSpin{to{transform:rotate(360deg)}}
.project-detail-page .project-hero__title,.project-detail-page .project-feature__title{font-family:var(--a-font-body);font-weight:var(--a-weight-regular);letter-spacing:0}
.project-draft-row { display:flex; align-items:center; gap:var(--a-space-3); }
.project-draft-row .project-plain-row { flex:1; min-width:0; }
.project-draft-delete { flex:none; color:var(--a-danger); padding:0 var(--a-space-3); min-height:var(--a-hit); font-weight:var(--a-weight-regular); }

.capture-choice-option{border-radius:var(--a-radius-pill)}

.capture-choice-option--primary{border-radius:var(--a-radius-pill)}

/* 借 ui-button-reset 清样式的列表行/卡片，不是按键，保持直角。 */
.project-gallery-link.project-gallery-link{border-radius:0!important}
