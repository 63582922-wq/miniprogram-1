<view class="page project-detail-page">
  <page-nav-bar title="项目详情" showBack="{{true}}" />
  <view class="card detail-card">
    <view class="detail-card__head">
      <view>
        <view class="section-title">{{project.name}}</view>
        <view class="section-subtitle">{{project.address}}</view>
      </view>
      <view class="detail-card__status">{{project.statusText || '进行中'}}</view>
    </view>
    <view class="detail-card__meta">甲方：{{project.clientNameText}}{{project.clientPhoneText ? ' · ' + project.clientPhoneText : ''}}</view>
    <view wx:if="{{project.description}}" class="detail-card__meta">{{project.description}}</view>
    <view class="workspace-stats">
      <view class="workspace-stats__item">
        <view class="workspace-stats__value">{{workspaceStats.inspections}}</view>
        <view class="workspace-stats__label">巡查</view>
      </view>
      <view class="workspace-stats__item">
        <view class="workspace-stats__value">{{workspaceStats.reports}}</view>
        <view class="workspace-stats__label">报告</view>
      </view>
    </view>
    <view class="project-detail__action-button {{coachHighlightInspection ? 'coach-highlight' : ''}}" bindtap="goInspectionCreate">快速巡查</view>
  </view>
  <view wx:if="{{coachTipVisible}}" class="coach-tip">
    <view class="coach-tip__title">{{coachTipTitle}}</view>
    <view class="coach-tip__arrow">{{coachTipArrow}}</view>
    <view class="coach-tip__desc">{{coachTipDesc}}</view>
    <view class="coach-tip__actions">
      <view class="coach-tip__btn coach-tip__btn--ghost" bindtap="handleCoachPrev">上一步</view>
      <view class="coach-tip__btn coach-tip__btn--ghost" bindtap="handleCoachSkip">跳过</view>
      <view class="coach-tip__btn" bindtap="handleCoachNext">下一步</view>
    </view>
  </view>

  <view class="card shortcut-card">
    <view class="workspace-card__header workspace-card__header--compact">
      <view class="section-title">工作台</view>
    </view>
    <view class="shortcut-grid">
      <view class="shortcut-item" bindtap="goInspectionList">
        <image class="shortcut-item__icon" src="/images/icons/icon-inspection.svg" mode="aspectFit" />
        <view class="shortcut-item__title">全部巡查</view>
        <view class="shortcut-item__meta">{{workspaceStats.inspections}} 条记录</view>
        <image class="shortcut-item__arrow" src="/images/icons/icon-arrow-right.svg" mode="aspectFit" />
      </view>
      <view class="shortcut-item" bindtap="goGallery">
        <image class="shortcut-item__icon" src="/images/icons/icon-gallery.svg" mode="aspectFit" />
        <view class="shortcut-item__title">项目相册</view>
        <view class="shortcut-item__meta">图片与标注资料</view>
        <image class="shortcut-item__arrow" src="/images/icons/icon-arrow-right.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="project-detail__action-button shortcut-card__edit" bindtap="goEdit">编辑项目</view>
  </view>

  <view class="card workspace-card">
    <view class="workspace-card__header workspace-card__header--compact">
      <view class="section-title">最近巡查</view>
      <view class="workspace-card__actions">
        <view class="workspace-card__link" bindtap="toggleRecentInspection">{{recentInspectionExpanded ? '收起' : '展开'}}</view>
        <view class="workspace-card__link" bindtap="goInspectionList">查看全部</view>
      </view>
    </view>
    <view wx:if="{{recentInspectionExpanded && latestInspection}}" class="list">
      <view class="detail-row" data-inspection-id="{{latestInspection._id}}" bindtap="openInspection">
        <view class="detail-row__title">{{latestInspection.title}}</view>
        <view class="detail-row__desc">{{latestInspection.createdAtText}}</view>
      </view>
    </view>
    <view wx:elif="{{inspections.length}}" class="empty-hint">已折叠，仅显示最近 1 条</view>
    <view wx:else class="empty-hint">还没有巡查记录</view>
  </view>

  <view class="card workspace-card">
    <view class="workspace-card__header workspace-card__header--compact">
      <view class="section-title">最近报告</view>
      <view class="workspace-card__actions">
        <view class="workspace-card__link" bindtap="toggleRecentReport">{{recentReportExpanded ? '收起' : '展开'}}</view>
        <view class="workspace-card__link" bindtap="goReportList">查看全部</view>
      </view>
    </view>
    <view wx:if="{{recentReportExpanded && latestReport}}" class="list">
      <view class="detail-row" data-report-id="{{latestReport._id}}" bindtap="openReport">
        <view class="detail-row__title">{{latestReport.title}}</view>
        <view class="detail-row__desc">{{latestReport.generatedAtDisplay}}</view>
      </view>
    </view>
    <view wx:elif="{{reports.length}}" class="empty-hint">已折叠，仅显示最近 1 条</view>
    <view wx:else class="empty-hint">暂无报告</view>
  </view>

</view>
