<view class="page project-detail-page">
  <page-nav-bar title="项目详情" showBack="{{true}}" />
  <view wx:if="{{loading}}" class="precision-state">正在加载项目…</view>
  <view wx:elif="{{loadError}}" class="precision-state">{{loadError}}<button class="ui-button-reset secondary-button" bindtap="loadDetail">重试</button></view>
  <block wx:else>
    <view class="project-hero">
      <view class="project-hero__head ui-section-row"><view class="project-hero__eyebrow ui-section-row__label">当前项目</view><button class="ui-button-reset project-hero__edit ui-section-row__action" bindtap="goEdit">编辑资料</button></view>
      <view class="project-hero__title {{projectTitleClass}}">{{project.name}}</view>
      <view class="project-hero__address">{{project.address}}</view>
      <view wx:if="{{project.clientName}}" class="project-hero__meta">甲方：{{project.clientNameText}}{{project.clientPhoneText ? ' · ' + project.clientPhoneText : ''}}</view>
      <view wx:if="{{project.description}}" class="project-hero__meta">{{project.description}}</view>
    </view>

    <button class="ui-button-reset primary-button project-hero__action" id="coach-start-record" bindtap="goInspectionCreate"><image class="project-hero__action-icon" src="/images/icons/icon-tab-camera.svg" mode="aspectFit" />开始现场记录</button>

    <view wx:if="{{drafts.length}}" class="project-section">
      <view class="project-section__head">
        <view class="project-section__label">未完成记录</view>
        <view class="project-section__hint">{{drafts.length}} 条待继续</view>
      </view>
      <view wx:for="{{drafts}}" wx:key="sessionKey" class="project-draft-row">
      <button class="ui-button-reset project-plain-row project-plain-row--last" data-session="{{item.sessionKey}}" bindtap="continueDraft">
        <view class="project-plain-row__content"><view class="project-plain-row__title">{{item.title || project.name}}</view><view class="project-plain-row__desc">{{item.issueCount}} 张照片 · {{item.timeText}}</view></view><image class="project-plain-row__icon" src="/images/icons/icon-arrow-right.svg" mode="aspectFit" />
      </button>
      <button class="ui-button-reset project-draft-delete" data-session="{{item.sessionKey}}" bindtap="deleteDraft">删除</button>
      </view>
    </view>

    <button class="ui-button-reset project-gallery-link" bindtap="goGallery">查看全部照片<text class="project-gallery-link__count">{{featurePhotoCount}} 张</text><image class="project-gallery-link__icon" src="/images/icons/icon-arrow-right.svg" mode="aspectFit" /></button>


  </block>
  <view wx:if="{{captureChoiceOpen}}" class="capture-choice-mask" catchtap="closeCaptureChoice">
    <view class="capture-choice-panel" catchtap="ignoreTap">
      <view class="capture-choice-title ui-sheet-title">添加现场照片</view>
      <view class="capture-choice-subtitle">照片会保存到「{{project.name}}」</view>
      <button class="ui-button-reset capture-choice-option capture-choice-option--primary" data-source-type="camera" bindtap="chooseCaptureSource"><image class="capture-choice-option__icon" src="/images/icons/icon-tab-camera.svg" mode="aspectFit" /><text>拍照</text></button>
      <button class="ui-button-reset capture-choice-option" data-source-type="album" bindtap="chooseCaptureSource"><image class="capture-choice-option__icon" src="/images/icons/icon-gallery.svg" mode="aspectFit" /><text>上传照片</text></button>
      <button class="ui-button-reset capture-choice-cancel" bindtap="closeCaptureChoice">取消</button>
    </view>
  </view>
  <view wx:if="{{capturePicking}}" class="capture-saving-mask"><view class="capture-saving-panel"><view class="capture-saving-indicator"></view><text>正在保存照片…</text></view></view>
  <coach-overlay visible="{{coachVisible}}" rect="{{coachRect}}" title="{{coachTitle}}" desc="{{coachDesc}}" stepText="{{coachStepText}}" pendingText="{{coachPendingText}}" bind:next="handleCoachNext" bind:skip="handleCoachSkip" />
</view>
