.onboarding-page {display:flex;flex-direction:column;gap:0;padding-bottom:calc(var(--a-space-4) + env(safe-area-inset-bottom))}

.onboarding-summary{margin:0}

.onboarding-summary__title {
  font-size:var(--a-type-body);
  font-weight:var(--a-weight-regular);
  color: var(--a-ink);
  letter-spacing: 0.04em;
}

.onboarding-summary__desc {
  margin-top: var(--a-space-1);
  font-size:var(--a-type-caption);
  line-height: 1.7;
  color: var(--a-muted);
}

.onboarding-steps{display:flex;flex-direction:column;gap:0}

.onboarding-step{display:flex;flex-direction:column;gap:var(--a-space-2);padding:var(--a-space-4) 0;}

.onboarding-step--done{background:transparent}

.onboarding-step__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.onboarding-step__title {
  font-size:var(--a-type-action);
  font-weight:var(--a-weight-regular);
  color: var(--a-ink);
  letter-spacing: 0.04em;
}

.onboarding-step__status{font-size:var(--a-type-caption);color:var(--a-active)}

.onboarding-step__desc {
  font-size:var(--a-type-caption);
  line-height: 1.7;
  color: var(--a-muted);
}

.onboarding-step__tip-trigger{width:auto!important;align-self:flex-start;min-height:var(--a-hit);display:flex;align-items:center;margin:var(--a-space-1) 0 0!important;padding:0!important;color:var(--a-active);font-size:var(--a-type-caption);background:transparent}

.onboarding-step__action {
  width: 100%!important;
  margin-top: var(--a-space-1);
}

.onboarding-actions{display:flex;gap:var(--a-space-2);margin-top:var(--a-space-3)}.onboarding-actions>.secondary-button,.onboarding-actions>.primary-button{flex:1;min-width:0;margin:0!important}

.guide-tip-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--a-scrim);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.guide-tip-panel {
  width: 100%;
  padding: var(--a-space-4) var(--a-space-3) calc(env(safe-area-inset-bottom) + var(--a-space-3));
  border-top-left-radius: 4rpx;
  border-top-right-radius: 4rpx;
  background: var(--a-surface);
  box-sizing: border-box;
}

.guide-tip-title {
  font-size:var(--a-type-action);
  font-weight:var(--a-weight-regular);
  color: var(--a-ink);
  letter-spacing: 0.04em;
}

.guide-tip-content {
  margin-top: var(--a-space-2);
  font-size:var(--a-type-meta);
  line-height: 1.8;
  color: var(--a-muted);
}

.guide-tip-button {
  width: 100%!important;
  margin-top: var(--a-space-3);
  min-height: var(--a-hit-primary);
  border-radius: 0;
  background: var(--a-accent);
  color: var(--a-accent-ink);
  font-size:var(--a-type-medium);
  font-weight:var(--a-weight-regular);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0;
}

.guide-tip-button::after,
.onboarding-step__tip-trigger::after {
  border: 0;
}
