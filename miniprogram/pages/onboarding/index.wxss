.onboarding-page {display:flex;flex-direction:column;gap:0;padding-bottom:32rpx}

.onboarding-summary{margin:0}

.onboarding-summary__title {
  font-size: 32rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
  letter-spacing: 0.04em;
}

.onboarding-summary__desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--a-muted, #706D67);
}

.onboarding-steps{display:flex;flex-direction:column;gap:0}

.onboarding-step{display:flex;flex-direction:column;gap:12rpx;padding:28rpx 0;border-bottom:1px solid var(--a-line)}

.onboarding-step--done{background:transparent}

.onboarding-step__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.onboarding-step__title {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
  letter-spacing: 0.04em;
}

.onboarding-step__status{font-size:26rpx;color:var(--a-active)}

.onboarding-step__desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--a-muted, #706D67);
}

.onboarding-step__tip-trigger{width:auto!important;align-self:flex-start;min-height:44px;display:flex;align-items:center;margin:2rpx 0 0!important;padding:0!important;color:var(--a-active);font-size:26rpx;background:transparent}

.onboarding-step__action {
  width: 100%!important;
  margin-top: 4rpx;
}

.onboarding-actions{display:flex;gap:16rpx;margin-top:24rpx}.onboarding-actions>button{flex:1;min-width:0;margin:0!important}

.guide-tip-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.guide-tip-panel {
  width: 100%;
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  border-top-left-radius: 4rpx;
  border-top-right-radius: 4rpx;
  background: var(--a-surface, #E2DCD3);
  box-sizing: border-box;
}

.guide-tip-title {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--a-ink, #191816);
  letter-spacing: 0.04em;
}

.guide-tip-content {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--a-muted, #706D67);
}

.guide-tip-button {
  width: 100%!important;
  margin-top: 24rpx;
  height: 84rpx;
  border-radius: 0;
  background: var(--a-accent);
  color: var(--a-accent-ink);
  font-size: 28rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0;
}

.guide-tip-button::after,
.onboarding-step__tip-trigger::after {
  border: 0;
}
