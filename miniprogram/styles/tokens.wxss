/*
 * Deprecated semantic aliases retained for older templates.
 * The only source of visual values is precision-a.wxss.
 * Do not add independent colors, type scales, spacing, radii or shadows here.
 */
@import "./precision-a.wxss";

.page,:host,.custom-tab-bar {
  --color-primary: var(--a-ink);
  --color-accent: var(--a-accent);
  --color-accent-soft: var(--a-accent-wash);
  --color-text: var(--a-ink);
  --color-text-secondary: var(--a-muted);
  --color-text-tertiary: var(--a-muted-tertiary);
  --color-text-inverse: var(--a-paper);
  --color-bg: var(--a-paper);
  --color-bg-card: var(--a-paper);
  --color-bg-elevated: var(--a-field);
  --color-bg-sunken: var(--a-surface);
  --color-bg-dark: var(--a-ink-deep);
  --color-border: var(--a-line);
  --color-border-light: var(--a-photo-matte);
  --color-border-strong: var(--a-line-strong);
  --color-urgent: var(--a-danger);
  --color-urgent-bg: var(--a-danger-surface);
  --color-active: var(--a-active);
  --color-active-bg: var(--a-surface);
  --color-warning: var(--a-warning);
  --color-warning-bg: var(--a-warning-surface);
  --color-idle: var(--a-muted-tertiary);
  --color-idle-bg: var(--a-surface);

  --font-sans: var(--a-font-body);
  --font-display: var(--a-font-display);
  --text-xs: var(--a-type-caption);
  --text-sm: var(--a-type-caption);
  --text-base: var(--a-type-body);
  --text-md: var(--a-type-action);
  --text-lg: var(--a-type-object);
  --text-xl: var(--a-type-title);
  --text-2xl: var(--a-type-display);

  --space-xs: var(--a-space-1);
  --space-sm: var(--a-space-2);
  --space-base: var(--a-space-2);
  --space-lg: var(--a-space-3);
  --space-xl: var(--a-space-4);
  --space-2xl: var(--a-space-5);
  --space-3xl: var(--a-space-6);
  --radius-base: var(--a-radius-control);
  --radius-lg: var(--a-radius-object);
  --radius-full: 9999rpx;
  --shadow-sm: none;
  --shadow-base: none;
  --shadow-md: none;
  --shadow-lg: none;
  --shadow-fab: none;
}
